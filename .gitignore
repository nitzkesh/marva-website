# Website build (Astro app has its own nested .gitignore too, this covers the whole project)
website/app/node_modules/
website/app/dist/
website/app/.astro/
website/app/.wrangler/

# OS / editor
.DS_Store
.idea/

# env/secrets
.env
.env.production
.dev.vars*
!.dev.vars.example
!.env.example

# The design-system export (Claude Design desktop app) is Nitzan's forward design source — tracked.
# Only its bulky .zip archive stays ignored (track the folder, not the archive).
marva-design-system-viaClaudeD.zip

# Raw source photos (large originals; optimized WebP copies actually used by the site
# live in website/app/public/photos/ and are committed there)
photos-for-website/

# Brand book PDF build artifacts (build-pdf.js regenerates these; not source)
brand-book/.chrome-profile/
brand-book/_build_temp.html
