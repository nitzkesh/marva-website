884 302.018 552.283 293.365C551.45 281.394 550.862 270.901 565.077 268.378Z"/><path fill="var(--color-ink)" d="M731.406 653.578C742.326 653.904 751.626 660.133 753.415 671.381C754.398 677.256 752.872 683.273 749.208 687.97C743.704 695.089 736.967 696.568 728.698 697.57C722.521 697.636 717.744 696.985 712.585 693.164C708.164 689.92 705.289 684.984 704.649 679.538C703.86 673.422 705.683 667.257 709.67 662.553C715.734 655.413 722.775 654.196 731.406 653.578Z"/><path fill="var(--color-ink)" d="M728.99 710.515C734.05 710.351 739.123 711.425 743.381 714.269C748.197 717.484 751.419 722.596 752.242 728.329C753.138 734.014 751.634 739.817 748.088 744.351C742.785 751.192 736.431 752.54 728.553 753.67C716.315 753.764 705.365 748.589 704.193 735.042C703.664 729.272 705.484 723.531 709.242 719.121C714.779 712.592 721.102 711.274 728.99 710.515Z"/><path fill="var(--color-ink)" d="M727.047 587.428C729.045 587.275 731.046 587.163 733.049 587.092C740.823 586.863 747.906 588.197 753.681 593.907C757.883 598.054 760.182 603.753 760.034 609.654C759.866 617.182 756.377 622.968 751.035 627.932C743.106 634.098 735.967 634.787 726.486 635.524C726.469 628.999 725.792 591.037 727.047 587.428Z"/><path fill="var(--color-ink)" d="M727.47 766.739C737.901 765.837 746.975 770.977 749.455 781.557C750.682 786.724 749.762 792.169 746.906 796.647C743.067 802.62 738.405 804.393 732 805.912C726.255 806.331 721.57 806.075 716.491 802.764C712.355 800.093 709.493 795.845 708.573 791.008C707.507 785.701 708.621 780.188 711.663 775.711C715.762 769.747 720.832 767.97 727.47 766.739Z"/><path fill="var(--color-ink)" d="M557.678 339.32L662.638 339.356C665.287 341.008 670.313 343.537 668.944 347.155C666.951 348.523 665.716 348.281 663.279 348.329L591.09 348.367C583.267 348.372 555.552 349.246 550.335 346.932L550.115 345.812C551.928 342.391 554.443 341.274 557.678 339.32Z"/><g class="kpi-a-heart"><path fill="var(--color-sage)" d="M824.678 322.312C852.808 318.716 875.869 336.071 888.61 359.851C892.529 354.888 897.01