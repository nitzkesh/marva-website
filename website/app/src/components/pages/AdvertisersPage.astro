---
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Button from '../Button.astro';
import Card from '../Card.astro';
import Input from '../Input.astro';
import MarvaLabel from '../MarvaLabel.astro';
import { getContent, canonicalHref, visible, type Locale } from '../../data/content';
import sections from '../../data/sections.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const {
  heroBottleAlt,
  ui,
  formStartHeading,
  advertisersMeta,
  advertisersHero,
  kpis,
  labelPromo,
  advertiserOptions,
  whyAdvertiseHeading,
  whyAdvertise,
  howHeading,
  howSteps,
  adForm,
} = getContent(locale);

const privacyHref = canonicalHref('privacy', locale);

/* Label-demo mockup visibility. Flip to true to bring back the label-
   proportions mockup + caption in the promo section below — markup is left
   in place, this const is the only thing gating whether it renders. */
const showLabelDemo = false;

/* Inline stroke-style vector icons for the why-advertise items (same style as
   the how-icons on the home page: currentColor, ~40px, 2px stroke). */
const whyIcons: Record<string, string> = {
  target: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="36" height="36" aria-hidden="true"><circle cx="24" cy="24" r="18"/><circle cx="24" cy="24" r="11"/><circle cx="24" cy="24" r="4"/></svg>`,
  label: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="36" height="36" aria-hidden="true"><rect x="6" y="14" width="36" height="20" rx="3"/><path d="M34 14v20"/><path d="M12 22h14"/><path d="M12 27h9"/><circle cx="38" cy="24" r="1.5"/></svg>`,
  crowd: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="36" height="36" aria-hidden="true"><circle cx="24" cy="15" r="5"/><path d="M14 35c0-6 4.5-10 10-10s10 4 10 10"/><circle cx="9" cy="19" r="4"/><path d="M3 35c0-4.5 2.5-8 6-9.3"/><circle cx="39" cy="19" r="4"/><path d="M45 35c0-4.5-2.5-8-6-9.3"/></svg>`,
  megaphone: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="36" height="36" aria-hidden="true"><path d="M6 20v8a3 3 0 0 0 3 3h3l14 9V8L12 17H9a3 3 0 0 0-3 3Z"/><path d="M26 17a7 7 0 0 1 0 14"/><path d="M33 12a15 15 0 0 1 0 24"/></svg>`,
};

/* Inline stroke-style vector icons for the "how it works" steps — moved here
   from the home page (was section C there), same house style. */
const howIcons: Record<string, string> = {
  document: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="40" height="40" aria-hidden="true"><path d="M14 6h14l8 8v28a2 2 0 0 1-2 2H14a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Z"/><path d="M28 6v8h8"/><path d="M17 26h14"/><path d="M17 32h14"/><path d="M17 20h6"/></svg>`,
  bottle: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="40" height="40" aria-hidden="true"><path d="M19 4L29 4L29 9L27 9L27 14Q35 17 35 23L35 38Q35 42 31 42L17 42Q13 42 13 38L13 23Q13 17 21 14L21 9L19 9Z"/><path d="M15 27h18"/><path d="M15 34h18"/></svg>`,
  rocket: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="40" height="40" aria-hidden="true"><path d="M24 4c6 4 9 11 9 18 0 4-1 8-3 11l-6 5-6-5c-2-3-3-7-3-11 0-7 3-14 9-18Z"/><circle cx="24" cy="18" r="3.5"/><path d="M17 30l-6 4 2-8"/><path d="M31 30l6 4-2-8"/><path d="M20 38h8l-4 6-4-6Z"/></svg>`,
};

/* Inline stroke-style vector icons for the KPI band (same house style as
   whyIcons above: currentColor, 2px stroke), rendered at 88px — larger than
   the whyAdvertise icons because these carry the band on their own, with no
   plate behind them.

   Every element carrying a `kpi-a-*` class is an animation handle; the
   keyframes live in global.css under "KPI icons". Each icon plays a short beat
   on a long 10s loop. Loops stay paused on each icon until its own `.kpi-item`
   gets `.is-playing` when that card lands, one second after the previous one
   (see the page script).

   `roi` is a stationary rocket — only the air stripes and burner flame move.
   `value` is a thin-ring compass: the ring is fixed, the needle spins a full
   continuous 360deg with no start/stop beat — approved as a standalone
   preview before landing here, see the `kpi-compass-spin` keyframes below. */
const kpiIcons: Record<string, string> = {
  roi: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="88" height="88" aria-hidden="true"><g class="kpi-a-rocket"><line class="kpi-a-stripe" x1="4" y1="30" x2="14" y2="26"/><line class="kpi-a-stripe" x1="3" y1="35" x2="14" y2="31"/><line class="kpi-a-stripe" x1="5" y1="40" x2="15" y2="36"/><path d="M28 6c0 0 5.5 6 5.5 15.5v6.5c0 2-2.5 3-5.5 3s-5.5-1-5.5-3v-6.5C22.5 12 28 6 28 6z"/><circle cx="28" cy="18" r="2.5"/><path d="M22.5 29.5 17 37l5-1.8"/><path d="M33.5 29.5 39 37l-5-1.8"/><g class="kpi-a-flame"><path d="M24.5 34.5c0 0-1.5 4.2 3.5 7 5-2.8 3.5-7 3.5-7"/><path d="M26.5 35c0 0-.2 2.4 1.5 4.2 1.7-1.8 1.5-4.2 1.5-4.2"/></g></g></svg>`,
  impressions: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="88" height="88" aria-hidden="true"><circle class="kpi-a-ring" cx="24" cy="24" r="17"/><circle class="kpi-a-ring" cx="24" cy="24" r="10.5"/><g class="kpi-a-cross"><line x1="24" y1="2" x2="24" y2="9"/><line x1="24" y1="39" x2="24" y2="46"/><line x1="2" y1="24" x2="9" y2="24"/><line x1="39" y1="24" x2="46" y2="24"/></g><circle class="kpi-a-dot" cx="24" cy="24" r="3" fill="currentColor" stroke="none"/></svg>`,
  /* Hand-holding-bottle + heart — supplied by Nitzan as a flat two-tone
     glyph, paths reproduced verbatim (only the embedded C2PA provenance
     metadata was stripped since it doesn't render). Recolored for a
     transparent background on the black band: the original was #1A1B1D
     silhouette + white detail lines on its own white backdrop square: the
     backdrop is dropped, the silhouette becomes sage (matching the other two
     KPI icons' currentColor), and the detail lines become ink (matching the
     band's own background) so they still read as cut-out highlights rather
     than washing out as white-on-light-green noise. The heart is wrapped in
     its own <g class="kpi-a-heart"> so it can pump independently — see "KPI
     icons" in global.css. transform-box:fill-box there scales it around its
     own centre, not the icon's, so growing on the beat can't walk it into
     the bottle. */
  value: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="258 232 764 764" width="128" height="128" aria-hidden="true"><path fill="var(--color-sage)" d="M564.622 255.528C592.049 254.123 620.903 256.05 648.436 255.311C679.737 254.472 681.037 274.119 680.075 299.158C679.568 312.353 682.843 321.56 673.685 333.269C685.843 342.058 685.198 355.223 669.753 359.115C669.82 378.936 671.096 378.234 685.525 390.693C697.152 400.733 708.921 414.576 716.906 427.577C733.062 453.845 737.324 486.029 733.493 516.293C730.958 536.322 727.936 554.37 726.97 574.662C734.856 574.142 741.191 573.919 748.858 576.389C757.703 579.159 765.018 585.447 769.087 593.775C779.255 614.69 767.82 634.828 748.268 644.452C753.044 647.392 756.022 649.539 759.491 654.083C764.992 661.363 767.388 670.524 766.156 679.565C764.608 690.735 759.426 697.392 750.776 703.817C753.353 705.834 756.024 708.034 758.035 710.62C763.696 718.036 766.11 727.43 764.726 736.656C763.143 747.704 758.292 753.757 749.81 760.132C764.16 772.666 767.624 791.615 754.743 807.416C748.009 815.677 738.202 818.157 727.864 818.66C728.627 850.964 736.902 885.907 729.717 917.869C727.01 929.91 717.626 941.545 706.765 947.392C676.958 963.3 644.377 948.366 613.071 947.965C573.704 947.461 518.872 972.554 494.319 927.307C490.384 917.725 489.283 912.633 488.52 902.284C477.563 905.633 466.772 907.588 456.072 910.917C448.916 913.143 438.637 918.832 431.841 922.483C438.604 943.219 424.905 947.455 409.893 955.121C404.532 957.958 399.252 960.665 393.879 963.508C381.764 969.92 365.374 980.599 355.911 963.885C351.134 955.449 346.8 946.394 342.343 937.645L317.697 889.485L293.41 842.959C290.784 837.973 280.218 818.821 279.278 814.351C278.391 810.002 279.302 805.479 281.805 801.813C283.513 799.351 285.841 797.396 288.353 795.794C294.721 791.732 335.109 770.841 340.992 769.821C347.75 768.649 352.475 770.955 357.739 774.804C380.373 759.631 380.999 748.848 389.417 723.309C396.223 702.66 402.141 678.664 413.47 660.05C422.567 645.103 434.926 630.292 445.789 616.41C460.959 596.896 476.266 577.489 491.708 558.19C489.344 536.136 484.984 514.497 484.862 493.16C484.594 446.4 508.802 410.13 544.136 381.984C550.38 377.01 549.999 366.923 549.995 359.383C534.035 354.694 533.46 342.9 546.092 333.411C535.887 321.972 540.411 306.212 539.535 291.966C538.296 271.807 542.434 258.641 564.622 255.528Z"/><path fill="var(--color-ink)" d="M712.263 587.945L713.379 587.927C714.802 589.708 714.2 637.994 714.293 644.036C708.198 646.797 703.752 649.604 699.52 654.902C693.505 662.484 690.893 672.215 692.303 681.79C693.824 692.449 698.69 698.602 706.875 704.791C685.369 719.87 686.711 746.793 707.902 761.718C704.115 764.863 701.625 767.556 699.288 771.966C695.27 779.644 694.441 788.596 696.981 796.881C700.19 807.287 706.172 812.045 715.228 816.66L715.446 825.984C670.273 842.911 604.53 843.228 557.15 836.845C539.117 834.233 522.147 830.588 505.587 822.693C505.845 811.789 506.815 799.915 507.316 788.892C508.407 767.28 508.822 745.639 508.56 724.001C508.417 714.241 505.801 682.158 508.867 675.335C512.547 667.146 519.266 659.273 524.419 651.901C537.205 633.606 547.341 615.133 553.852 593.628C610.431 599.412 655.945 600.361 712.263 587.945Z"/><path fill="var(--color-ink)" d="M562.863 359.089C594.192 359.592 625.754 359 657.116 359.255C656.648 392.025 667.283 389.155 688.129 411.167C699.002 422.465 707.657 435.703 713.646 450.194C731.369 493.795 715.432 531.13 714.315 576.221C688.211 582.137 669.633 584.041 642.856 585.627C618.547 587.304 579.926 585.842 555.935 582.21C558.661 567.642 556.935 549.04 545.495 538.61C530.377 524.825 514.87 530.997 502.838 544.195C500.507 523.874 496.449 506.238 497.914 485.245C500.197 452.522 515.795 425.106 539.731 403.215C546.625 396.91 555.652 390.77 559.677 382.25C563.227 374.736 561.893 367.337 562.799 359.592L562.863 359.089Z"/><path fill="var(--color-ink)" d="M525.134 543.783C529.623 543.74 533.458 544.995 536.727 548.162C550.234 561.25 543.214 587.081 537.542 602.174C532.279 616.18 524.531 628.969 516.106 641.274C509.827