<Layout title={advertisersMeta.title} description={advertisersMeta.description} locale={locale} page="advertisers">

  <Header locale={locale} page="advertisers" />

  <main id="main-content">

    <!-- ═══════════════════ A. HERO ═══════════════════ -->
    {sections.advertisers.hero && (
    <section class="relative overflow-hidden bg-base py-16 md:py-20">
      <!-- 2 soft sage-leaning wave shapes, lighter than the home hero -->
      <svg class="absolute bottom-0 inset-x-0 w-full h-20 md:h-28 z-0" viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,90 C240,130 480,50 720,80 C960,110 1200,50 1440,85 L1440,160 L0,160 Z" fill="var(--color-sage)" opacity="0.3"></path>
        <path d="M0,120 C240,90 480,150 720,120 C960,90 1200,150 1440,120 L1440,160 L0,160 Z" fill="var(--color-sage-deep)" opacity="0.18"></path>
      </svg>

      <div class="relative z-10 max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-[1.1fr_0.6fr] gap-10 md:gap-8 items-center">
        <div class="hero-copy max-w-[560px]">
          <h1 class="font-display font-black text-ink text-[clamp(2.25rem,4vw+1rem,3.75rem)] leading-[1.1]">
            {advertisersHero.h1}
          </h1>
          <p class="font-body text-ink/80 text-lg max-w-[520px] mt-4 mb-8">
            {advertisersHero.sub}
          </p>
          <Button href={advertisersHero.ctaHref} size="l">{advertisersHero.ctaLabel}</Button>
        </div>

        <div class="hero-visual relative w-full max-w-[200px] justify-self-center">
          <img src="/hero-bottle.webp" alt={heroBottleAlt} width="1024" height="1535" fetchpriority="high" class="w-full block [mask-image:radial-gradient(ellipse_55%_80%_at_50%_48%,#000_55%,transparent_100%)] [-webkit-mask-image:radial-gradient(ellipse_55%_80%_at_50%_48%,#000_55%,transparent_100%)]" />
        </div>
      </div>
    </section>
    )}

    <!-- ═══════════════════ A2. KPI BAND ═══════════════════ -->
    {sections.advertisers.kpis && (
    <section id="kpis" class="relative overflow-hidden bg-ink py-16 md:py-24">
      <!-- Wave caps: purely decorative, painted in a NEIGHBOURING section's own
           background colour so this band's straight top/bottom edges read as a
           wave cut out of the rectangle instead of a hard line. Top cap matches
           the hero above it (bg-base); bottom cap matches label-promo below it
           (bg-sage-tint). If either neighbour's background token ever changes,
           update the matching fill here too. -->
      <!-- Control points sit at each crest/trough with horizontal tangents, which
           is what makes these read as a sine-like wave rather than a tilted line.
           preserveAspectRatio="none" squashes the viewBox height into the cap
           height (200 units -> 96px at md), so the drawn amplitude has to be
           roughly double what you want on screen. -->
      <svg class="absolute top-0 inset-x-0 w-full h-16 md:h-24 z-0 pointer-events-none" viewBox="0 0 1440 200" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,0 L1440,0 L1440,55 C1320,55 1200,112 1080,112 C960,112 840,38 720,38 C600,38 480,112 360,112 C240,112 120,58 0,58 Z" fill="var(--color-base)"></path>
      </svg>
      <svg class="absolute bottom-0 inset-x-0 w-full h-16 md:h-24 z-0 pointer-events-none" viewBox="0 0 1440 200" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,200 L1440,200 L1440,145 C1320,145 1200,88 1080,88 C960,88 840,162 720,162 C600,162 480,88 360,88 C240,88 120,142 0,142 Z" fill="var(--color-sage-tint)"></path>
