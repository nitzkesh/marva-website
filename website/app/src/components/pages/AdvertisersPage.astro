  </main>

  <Footer locale={locale} page="advertisers" />

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { heroSpring } from '../../scripts/hero-spring';

    gsap.registerPlugin(ScrollTrigger);

    /* Task E — hero entrance (Motion spring, same pattern as home). */
    heroSpring();

    /* Task D — label-strip slow auto-pan (GSAP), reveals the full label incl.
       the regulatory zone; reads as the bottle slowly rotating. Only runs
       when the SVG actually overflows its viewport — on wide desktop widths
       the SVG fits at 100% and there's nothing to pan. */
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced) {
      const viewport = document.querySelector<HTMLElement>('.label-strip');
      const track = viewport?.querySelector<SVGSVGElement>('.label-strip-track');

      if (viewport && track) {
        const overflow = viewport.scrollWidth - viewport.clientWidth;

        if (overflow > 0) {
          const tween = gsap.to(track, {
            x: -overflow,
            duration: 12,
            ease: 'sine.inOut',
            repeat: -1,
            yoyo: true,
          });

          let hovering = false;
          let dragging = false;
          const maybeResume = () => {
            if (!hovering && !dragging) tween.play();
          };

          viewport.addEventListener('pointerenter', () => {
            hovering = true;
            tween.pause();
          });
          viewport.addEventListener('pointerleave', () => {
            hovering = false;
            maybeResume();
          });
          viewport.addEventListener('pointerdown', () => {
            dragging = true;
            tween.pause();
          });
          window.addEventListener('pointerup', () => {
            dragging = false;
            maybeResume();
          });
        }
      }
    }

    /* KPI band — count-up + item/icon entrance (GSAP ScrollTrigger). One-shot
       on scroll-in, never loops. Count-up reads its target from
       [data-count-to], which already holds the correct server-rendered final
       value; it's only reset to "1" when the figures are still below the
       trigger point, so a band that is already on screen at load keeps its
       real numbers instead of flashing 29 -> 1 -> 29.

       Trigger off the FIGURES ROW, not the section: the section opens with a
       96px wave cap plus the heading, so on a tall viewport its top crosses
       'top 80%' while the page is still at scroll 0 — the count would fire at
       load, finish off-screen, and the visitor would only ever meet a static
       29. Anchoring to the row means the trigger point and the "is it visible
       yet" guard describe the same element, and the numbers animate exactly
       when they come into view.

       Items land a full second apart (STAGGER below), and each figure's
       count-up sits inside its own item's slot on the timeline instead of
       every count-up firing together at t=0 — so the three cards read as a
       sequence arriving one after another, not one simultaneous pop. */
    if (!reduced) {
      const kpiSection = document.getElementById('kpis');
      const kpiItems = document.querySelectorAll<HTMLElement>('.kpi-item');
      const kpiRow = kpiItems[0]?.parentElement;

      if (kpiSection && kpiItems.length && kpiRow) {
        const countEls = kpiSection.querySelectorAll<HTMLElement>('[data-count-to]');
        const START_RATIO = 0.8; // matches the 'top 80%' used by every other reveal on the site
        const STAGGER = 1; // seconds between each item's entrance, so the three cards arrive one after another
        const belowFold = kpiRow.getBoundingClientRect().top >= window.innerHeight * START_RATIO;

        if (belowFold) {
          countEls.forEach((el) => {
            el.textContent = '1';
          });
        }

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: kpiRow,
            start: `top ${START_RATIO * 100}%`,
            once: true,
          },
        });

        kpiItems.forEach((item, i) => {
          const start = i * STAGGER;
          tl.from(item, { y: 30, opacity: 0, duration: 1, ease: 'power2.out', clearProps: 'transform' }, start);

          const icon = item.querySelector<HTMLElement>('.kpi-icon');
          if (icon) {
            tl.from(icon, { scale: 0.5, rotate: -12, opacity: 0, duration: 0.7, ease: 'back.out(1.7)', clearProps: 'transform' }, start + 0.2);
          }

          tl.call(() => item.classList.add('is-playing'), undefined, start);

          if (belowFold) {
            const countEl = item.querySelector<HTMLElement>('[data-count-to]');
            const target = Number(countEl?.dataset.countTo);
            if (countEl && Number.isFinite(target)) {
              const counter = { val: 1 };
              tl.to(counter, {
                val: target,
                duration: 2,
                ease: 'power2.out',
                onUpdate: () => {
                  countEl.textContent = String(Math.round(counter.val));
                },
              }, start);
            }
          }
        });
      }
    }

    /* How-it-works card sequence — moved here from the home page (was #how
       there). Cards enter one-by-one; on desktop (md+) each icon also pops in
       slightly after its card lands.

       Triggers off each card's OWN position via ScrollTrigger.batch, not off
       the section (#how): on mobile the cards stack vertically (w-full,
       thirds only at md), so a section-level trigger fires while the cards
       are still off screen — the reveal plays where nobody can see it and by
       the time the reader scrolls down the cards are already static. batch()
       still groups same-frame entries (the desktop row) into one staggered
       reveal, preserving the sequenced feel there. Matches the .where-card
       pattern in shared.ts. */
    if (!reduced) {
      const howCards = document.querySelectorAll<HTMLElement>('.how-card');
      const isDesktop = window.matchMedia('(min-width: 768px)').matches;

      if (howCards.length) {
        gsap.set(howCards, { y: 30, opacity: 0 });
        if (isDesktop) {
          const howIcons = document.querySelectorAll<HTMLElement>('.how-card-icon');
          if (howIcons.length) gsap.set(howIcons, { scale: 0.6, opacity: 0 });
        }

        ScrollTrigger.batch(howCards, {
          start: 'top 85%',
          onEnter: (batch) => {
            const cards = batch as HTMLElement[];
            // .how-card carries a Tailwind hover-lift transition on
            // `transform` (transition-[transform,box-shadow]). Left alone,
            // that CSS transition intercepts every transform GSAP writes
            // each tick and re-interpolates it over its own 200ms, smearing
            // the reveal instead of playing GSAP's 0.6s power2.out curve.
            // Suspend the transition for the reveal only, then hand it back
            // once the reveal has fully settled so the hover lift keeps its
            // 200ms ease.
            cards.forEach((el) => {
              el.style.transition = 'none';
            });

            const tl = gsap.timeline({
              onComplete: () => {
                cards.forEach((el) => {
                  // Force a reflow while transition is still 'none' so
                  // removing the inline transform (clearProps) isn't itself
                  // picked up and animated the instant the transition is
                  // restored.
                  void el.offsetHeight;
                  el.style.transition = '';
                });
              },
            });

            cards.forEach((card, i) => {
              const start = i * 0.18;
              tl.to(
                card,
                { y: 0, opacity: 1, duration: 0.6, ease: 'power2.out', clearProps: 'transform' },
                start,
              );

              if (isDesktop) {
                const icon = card.querySelector<HTMLElement>('.how-card-icon');
                if (icon) {
                  tl.to(
                    icon,
                    { scale: 1, opacity: 1, duration: 0.45, ease: 'back.out(1.7)', clearProps: 'transform' },
                    start + 0.15,
                  );
                }
              }
            });
          },
        });
      }
    }
  </script>
</Layout>
