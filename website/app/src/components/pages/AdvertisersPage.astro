---
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Button from '../Button.astro';
import Card from '../Card.astro';
import Input from '../Input.astro';
import { getContent, canonicalHref, visible, type Locale } from '../../data/content';
import sections from '../../data/sections.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const {
  heroBottleAlt,
  ui,
  formStartHeading,
  advertisersMeta,
  advertisersHero,
  labelPromo,
  advertiserOptions,
  whyAdvertiseHeading,
  whyAdvertise,
  adForm,
} = getContent(locale);

const privacyHref = canonicalHref('privacy', locale);

/* Label-demo mockup visibility. Flip to true to bring back the label-
   proportions mockup + caption in the promo section below — markup is left
   in place, this const is the only thing gating whether it renders. */
const showLabelDemo = false;

/* Inline stroke-style vector icons for the why-advertise items (same style as
   the how-icons on the home page: currentColor, ~40px, 2px stroke). */
const whyIcons: Record<string, string> = {
  target: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="36" height="36" aria-hidden="true"><circle cx="24" cy="24" r="18"/><circle cx="24" cy="24" r="11"/><circle cx="24" cy="24" r="4"/></svg>`,
  label: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="36" height="36" aria-hidden="true"><rect x="6" y="14" width="36" height="20" rx="3"/><path d="M34 14v20"/><path d="M12 22h14"/><path d="M12 27h9"/><circle cx="38" cy="24" r="1.5"/></svg>`,
  crowd: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="36" height="36" aria-hidden="true"><circle cx="24" cy="15" r="5"/><path d="M14 35c0-6 4.5-10 10-10s10 4 10 10"/><circle cx="9" cy="19" r="4"/><path d="M3 35c0-4.5 2.5-8 6-9.3"/><circle cx="39" cy="19" r="4"/><path d="M45 35c0-4.5-2.5-8-6-9.3"/></svg>`,
  megaphone: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="36" height="36" aria-hidden="true"><path d="M6 20v8a3 3 0 0 0 3 3h3l14 9V8L12 17H9a3 3 0 0 0-3 3Z"/><path d="M26 17a7 7 0 0 1 0 14"/><path d="M33 12a15 15 0 0 1 0 24"/></svg>`,
};
---

<Layout title={advertisersMeta.title} description={advertisersMeta.description} locale={locale} page="advertisers">

  <Header locale={locale} page="advertisers" />

  <main id="main-content">

    <!-- ═══════════════════ A. HERO ═══════════════════ -->
    {sections.advertisers.hero && (
    <section class="relative overflow-hidden bg-base py-16 md:py-20">
      <!-- 2 soft sage-leaning wave shapes, lighter than the home hero -->
      <svg class="absolute bottom-0 inset-x-0 w-full h-20 md:h-28 z-0" viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,90 C240,130 480,50 720,80 C960,110 1200,50 1440,85 L1440,160 L0,160 Z" fill="var(--color-sage)" opacity="0.3"></path>
        <path d="M0,120 C240,90 480,150 720,120 C960,90 1200,150 1440,120 L1440,160 L0,160 Z" fill="var(--color-sage-deep)" opacity="0.18"></path>
      </svg>

      <div class="relative z-10 max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-[1.1fr_0.6fr] gap-10 md:gap-8 items-center">
        <div class="hero-copy max-w-[560px]">
          <h1 class="font-display font-black text-ink text-[clamp(2.25rem,4vw+1rem,3.75rem)] leading-[1.1]">
            {advertisersHero.h1}
          </h1>
          <p class="font-body text-ink/80 text-lg max-w-[520px] mt-4 mb-8">
            {advertisersHero.sub}
          </p>
          <Button href={advertisersHero.ctaHref} size="l">{advertisersHero.ctaLabel}</Button>
        </div>

        <div class="hero-visual relative w-full max-w-[200px] justify-self-center">
          <img src="/hero-bottle.png" alt={heroBottleAlt} class="w-full block [mask-image:radial-gradient(ellipse_55%_80%_at_50%_48%,#000_55%,transparent_100%)] [-webkit-mask-image:radial-gradient(ellipse_55%_80%_at_50%_48%,#000_55%,transparent_100%)]" />
        </div>
      </div>
    </section>
    )}

    <!-- ═══════════════ B. PROMO — THE LABEL, UNROLLED ═══════════════ -->
    {sections.advertisers.labelPromo && (
    <section class="bg-sage-tint py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="font-display font-bold text-ink text-[clamp(1.75rem,3vw+0.5rem,3rem)] text-center">
          {labelPromo.heading}
        </h2>

        {showLabelDemo && (<>
        <!-- Label strip mockup: full flat label at true 210:42 proportions.
             .label-strip viewport = overflow-x auto (touch-scrollable now,
             animator pans it later). min-width on the SVG keeps proportions
             readable on small screens. -->
        <div class="label-strip bg-surface shadow-card max-w-5xl mx-auto mt-10" tabindex="0" role="img" aria-label={labelPromo.ariaLabel}>
          <svg viewBox="0 0 1050 210" width="100%" class="label-strip-track block min-w-[720px]" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
              <pattern id="reg-hatch" width="14" height="14" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
                <rect width="14" height="14" fill="var(--color-sand-tint)"></rect>
                <line x1="0" y1="0" x2="0" y2="14" stroke="var(--color-sand-deep)" stroke-width="3" opacity="0.55"></line>
              </pattern>
            </defs>

            <!-- label ground -->
            <rect x="0" y="0" width="1050" height="210" fill="var(--color-surface)"></rect>

            <!-- brand zone: dominant area, sage tint + big dashed outline -->
            <rect x="0" y="0" width="740" height="210" fill="var(--color-sage-tint)"></rect>
            <rect x="16" y="16" width="708" height="178" rx="10" fill="none" stroke="var(--color-sage-deep)" stroke-width="3" stroke-dasharray="14 10"></rect>
            <text x="370" y="100" text-anchor="middle" font-family="Rubik, sans-serif" font-weight="700" font-size="40" fill="var(--color-ink)">{labelPromo.brandZonePlaceholder}</text>
            <text x="370" y="142" text-anchor="middle" font-family="Rubik, sans-serif" font-weight="600" font-size="22" fill="var(--color-muted)">{labelPromo.brandZoneLabel}</text>

            <!-- regulatory zone: sand-tint hatch, right (RTL-start) end -->
            <rect x="740" y="0" width="310" height="210" fill="url(#reg-hatch)"></rect>
            <rect x="795" y="76" width="200" height="58" rx="29" fill="var(--color-surface)" opacity="0.92"></rect>
            <text x="895" y="113" text-anchor="middle" font-family="Rubik, sans-serif" font-weight="600" font-size="24" fill="var(--color-ink)">{labelPromo.regulatoryZoneLabel}</text>

            <!-- divider -->
            <line x1="740" y1="0" x2="740" y2="210" stroke="var(--color-border)" stroke-width="2"></line>
          </svg>
        </div>
        <p class="font-body text-sm text-muted text-center mt-4">{labelPromo.caption}</p>
        </>)}

        <!-- 3 option cards — plain, no animation -->
        <div class="flex flex-wrap justify-center gap-5 max-w-5xl mx-auto mt-12">
          {visible(advertiserOptions).map((o) => (
            <Card class="option-card w-full md:w-[calc(33.333%-0.834rem)]">
              <h3 class="font-display font-bold text-ink text-xl mb-2.5">{o.title}</h3>
              <p class="font-body text-ink/80">{o.body}</p>
            </Card>
          ))}
        </div>
      </div>
    </section>
    )}

    <!-- ═══════════════ C. WHY ADVERTISE WITH US ═══════════════ -->
    {sections.advertisers.whyAdvertise && (
    <section class="bg-surface py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="font-display font-bold text-ink text-[clamp(1.75rem,3vw+0.5rem,3rem)] text-center">
          {whyAdvertiseHeading}
        </h2>
        <div class="flex flex-wrap justify-center gap-x-10 gap-y-12 max-w-4xl mx-auto mt-14">
          {visible(whyAdvertise).map((w) => (
            <div class="why-card w-full sm:w-[calc(50%-1.25rem)] flex gap-5 items-start">
              <div class="shrink-0 w-16 h-16 rounded-full bg-sage-tint text-sage-deep flex items-center justify-center" set:html={whyIcons[w.icon]} />
              <div>
                <h3 class="font-display font-bold text-ink text-xl mb-2">{w.title}</h3>
                <p class="font-body text-ink/80">{w.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    )}

    <!-- ═══════════════ D. ADVERTISER FORM ═══════════════ -->
    {sections.advertisers.adForm && (
    <section id="ad-form" class="bg-sand-tint py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="font-display font-bold text-ink text-[clamp(1.75rem,3vw+0.5rem,3rem)] text-center">
          {formStartHeading}
        </h2>

        <div class="bg-surface rounded-[20px] shadow-card p-6 md:p-10 max-w-[780px] mx-auto mt-8">
          <form class="ad-form marva-form" data-subject={adForm.subject}>
            <input type="hidden" name="from_page" value={adForm.fromPage} />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
              <Input label={adForm.fields.businessName.label} name="business_name" placeholder={adForm.fields.businessName.placeholder} required />
              <Input label={adForm.fields.taxId.label} name="tax_id" placeholder={adForm.fields.taxId.placeholder} />
              <Input label={adForm.fields.contact.label} name="contact" placeholder={adForm.fields.contact.placeholder} required />
              <Input label={adForm.fields.phone.label} name="phone" type="tel" dir="ltr" placeholder={adForm.fields.phone.placeholder} required />
              <Input label={adForm.fields.email.label} name="email" type="email" dir="ltr" placeholder={adForm.fields.email.placeholder} required />
              <Input label={adForm.fields.qty.label} name="qty" placeholder={adForm.fields.qty.placeholder} />
              <Input label={adForm.fields.duration.label} name="duration" placeholder={adForm.fields.duration.placeholder} />
              <Input label={adForm.fields.startDate.label} name="start_date" type="date" dir="ltr" />
            </div>

            <div class="mb-5">
              <div class="form-label mb-2">{adForm.fields.deliveryLabel}</div>
              <div class="flex flex-col gap-2">
                <label class="radio-option">
                  <input type="radio" name="delivery" value="supply" checked />
                  <span>{adForm.fields.deliveryOptionSupply}</span>
                </label>
                <label class="radio-option">
                  <input type="radio" name="delivery" value="distribute" />
                  <span>{adForm.fields.deliveryOptionDistribute}</span>
                </label>
              </div>
              <div id="pref-points" class="conditional-fields">
                <div class="pt-3.5">
                  <Input label={adForm.fields.prefPoints.label} name="pref_points" placeholder={adForm.fields.prefPoints.placeholder} />
                </div>
              </div>
            </div>

            <div class="mb-6">
              <button type="button" id="save-toggle" class="py-2.5 px-4.5 rounded-full cursor-pointer bg-transparent border border-ink text-ink font-body font-semibold text-sm transition-colors">
                {adForm.fields.saveToggleLabel}
              </button>
              <div id="save-box" class="conditional-fields">
                <div class="mt-3.5 bg-sky-tint rounded-[10px] p-4">
                  <p class="font-body text-ink mb-3">{adForm.fields.saveBoxCopy}</p>
                  <label class="flex gap-2 items-start cursor-pointer font-body text-ink">
                    <input type="checkbox" name="split_label" class="mt-1" />
                    <span>{adForm.fields.splitLabelCheckbox}</span>
                  </label>
                </div>
              </div>
            </div>

            <label class="flex gap-2 items-start cursor-pointer font-body text-sm text-ink mb-5">
              <input type="checkbox" name="privacy_consent" value="agreed" required class="mt-1" />
              <span>{ui.consentPre} <a href={privacyHref} target="_blank" rel="noopener" class="underline hover:text-sage-deep transition-colors">{ui.consentLinkLabel}</a></span>
            </label>
            <Button size="l" class="w-full" type="submit">{adForm.fields.submitLabel}</Button>
          </form>
          <div class="form-thanks hidden text-center py-10 font-body text-lg text-sage-deep">{adForm.thanks}</div>
          <div class="form-error hidden text-center py-4 font-body text-sm text-red-600">{adForm.error}</div>
        </div>
      </div>
    </section>
    )}

  </main>

  <Footer locale={locale} page="advertisers" />

  <script>
    import gsap from 'gsap';
    import { heroSpring } from '../../scripts/hero-spring';

    /* Task E — hero entrance (Motion spring, same pattern as home). */
    heroSpring();

    /* Task D — label-strip slow auto-pan (GSAP), reveals the full label incl.
       the regulatory zone; reads as the bottle slowly rotating. Only runs
       when the SVG actually overflows its viewport — on wide desktop widths
       the SVG fits at 100% and there's nothing to pan. */
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced) {
      const viewport = document.querySelector<HTMLElement>('.label-strip');
      const track = viewport?.querySelector<SVGSVGElement>('.label-strip-track');

      if (viewport && track) {
        const overflow = viewport.scrollWidth - viewport.clientWidth;

        if (overflow > 0) {
          const tween = gsap.to(track, {
            x: -overflow,
            duration: 12,
            ease: 'sine.inOut',
            repeat: -1,
            yoyo: true,
          });

          let hovering = false;
          let dragging = false;
          const maybeResume = () => {
            if (!hovering && !dragging) tween.play();
          };

          viewport.addEventListener('pointerenter', () => {
            hovering = true;
            tween.pause();
          });
          viewport.addEventListener('pointerleave', () => {
            hovering = false;
            maybeResume();
          });
          viewport.addEventListener('pointerdown', () => {
            dragging = true;
            tween.pause();
          });
          window.addEventListener('pointerup', () => {
            dragging = false;
            maybeResume();
          });
        }
      }
    }
  </script>
</Layout>
