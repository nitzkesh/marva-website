---
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Button from '../Button.astro';
import Input from '../Input.astro';
import Badge from '../Badge.astro';
import ExpandCard from '../ExpandCard.astro';
import { getContent, canonicalHref, visible, type Locale } from '../../data/content';
import sections from '../../data/sections.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const {
  heroBottleAlt,
  ui,
  homeMeta,
  homeHero,
  conveyorLabel,
  conveyorChips,
  whoStatement,
  whereHeading,
  whereCards,
  findSpotsHeading,
  findSpots,
  testimonialsHeading,
  testimonials,
  bigButtonsHeading,
  bigButtons,
  inquiryTopics,
  inquiryForm,
} = getContent(locale);

const privacyHref = canonicalHref('privacy', locale);

/* Real photography for the "where" cards (replaces the earlier flat-SVG placeholders).
   Alt text is locale-dependent (from content), src is not. */
const cardPhotoSrc: Record<string, string> = {
  beach: '/photos/tlv-vibes.webp',
  storefront: '/photos/coffee-shop.webp',
  event: '/photos/social-event.webp',
  supermarket: '/photos/supermarket.webp',
};

const tintClasses = ['bg-sage-tint', 'bg-sky-tint', 'bg-sand-tint'];

const bigButtonTints: Record<string, { bg: string; hover: string }> = {
  sage: { bg: 'bg-sage-tint', hover: 'hover:bg-sage' },
  sky: { bg: 'bg-sky-tint', hover: 'hover:bg-sky' },
  sand: { bg: 'bg-sand-tint', hover: 'hover:bg-sand' },
};
---

<Layout title={homeMeta.title} description={homeMeta.description} locale={locale} page="home">

  <Header locale={locale} page="home" />

  <main id="main-content">

    <!-- ═══════════════════ A. HERO ═══════════════════ -->
    {sections.home.hero && (
    <section class="relative overflow-hidden bg-base pt-16 pb-0 md:pt-20">
      <div class="relative px-6 pb-16 md:pb-20">
        <!-- soft sun disc -->
        <div class="absolute top-6 start-6 w-40 h-40 rounded-full bg-sand opacity-40 blur-2xl z-0" aria-hidden="true"></div>

        <!-- eco-wave bands (behind content) -->
        <svg class="absolute bottom-0 inset-x-0 w-full h-28 md:h-40 z-0" viewBox="0 0 1440 220" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0,120 C240,180 480,60 720,100 C960,140 1200,60 1440,110 L1440,220 L0,220 Z" fill="var(--color-sand)" opacity="0.35"></path>
          <path d="M0,150 C240,90 480,190 720,140 C960,90 1200,170 1440,130 L1440,220 L0,220 Z" fill="var(--color-sky)" opacity="0.4"></path>
          <path d="M0,180 C240,140 480,200 720,170 C960,140 1200,200 1440,170 L1440,220 L0,220 Z" fill="var(--color-sage)" opacity="0.45"></path>
        </svg>

        <div class="relative z-10 max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-[1.05fr_0.9fr] gap-10 md:gap-8 items-center">
          <div class="hero-copy max-w-[560px]">
            <h1 class="font-display font-black text-ink text-[clamp(2.75rem,5vw+1rem,4.5rem)] leading-[1.05]">
              {homeHero.h1}
            </h1>
            <p class="font-display font-bold text-ink text-[clamp(1.5rem,3vw,2rem)] mt-4">
              {homeHero.sub}
            </p>
            {homeHero.line && (
              <p class="font-body text-ink/80 text-lg max-w-[520px] mt-4">
                {homeHero.line}
              </p>
            )}
            <Button href={homeHero.ctaHref} size="l" class="mt-8">{homeHero.ctaLabel}</Button>
          </div>

          <div class="hero-visual relative w-full max-w-[290px] justify-self-center">
            <img src="/hero-bottle.webp" alt={heroBottleAlt} width="1024" height="1535" fetchpriority="high" class="w-full block [mask-image:radial-gradient(ellipse_55%_80%_at_50%_48%,#000_55%,transparent_100%)] [-webkit-mask-image:radial-gradient(ellipse_55%_80%_at_50%_48%,#000_55%,transparent_100%)]" />
            <!-- Pinned to the label panel of /hero-bottle.webp, measured on the
                 1024x1535 source: x 332..693, y 500..752. Re-measure these four
                 percentages if the bottle photo is ever replaced. -->
            <div class="absolute top-[32.6%] left-[32.4%] w-[35.3%] h-[16.4%] flex flex-col items-center justify-center gap-[4px] px-1">
              <img src="/marva-mark.svg" alt="" class="w-[21%] h-auto object-contain" />
              <!-- Sized to keep both locales on a single line inside the ~102px
                   label: "YOUR BRAND HERE" is the wide case. Percentage padding
                   would resolve against .hero-visual, not this box, so the inset
                   is fixed. -->
              <span class="font-display font-bold text-ink text-center text-balance leading-[1.15] text-[clamp(0.5rem,1.35vw,0.58rem)]">
                {homeHero.bottleLabelLines.join(' ')}
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- conveyor strip -->
      {sections.home.conveyor && (
      <div class="relative z-10 border-t border-border bg-surface/70">
        <div class="max-w-6xl mx-auto px-6 py-7 md:py-8">
          <p class="font-body text-xs tracking-[0.12em] uppercase text-muted mb-3">{conveyorLabel}</p>
          <div class="overflow-hidden conveyor-viewport">
            <div class="conveyor-marquee">
              <!-- Two identical tracks, translated by exactly one track's width (50%)
                   per loop, so the belt loops seamlessly. Copy 0 is the live, interactive
                   strip (real CTA link, aria-hidden="false"); copy 1 is a decorative
                   duplicate (aria-hidden="true", non-interactive CTA stand-in).

                   Two is the minimum that still covers the viewport at every point in
                   the cycle, and it is enough BECAUSE of the loop-period invariant in
                   global.css: a track is always wider than the viewport, so one spare
                   copy always covers the gap the shift opens up. Verified 21/21 at both
                   breakpoints and both locales.

                   This was four copies until 2026-08-23. Four made the marquee 2993px
                   wide on mobile — 8979 device px at 3x, past the 8192 max texture size
                   many mobile GPUs have — so the compositor had to tile it, and the
                   one-track snap at each loop could expose a tile that had not been
                   rastered yet. That showed up as the chips vanishing for a frame once
                   per cycle. Two copies halve it to 4490 device px, inside the limit.
                   Do not add copies back without re-checking that number. -->
              {[0, 1].map((copy) => (
                <div class="conveyor-track" aria-hidden={copy === 0 ? 'false' : 'true'}>
                  {visible(conveyorChips).map((chip, i) => (
                    chip.isCta ? (
                      copy === 0 ? (
                        <a href={chip.href} class="conveyor-chip bg-ink text-inverse font-semibold hover:bg-[#2B2B2B] transition-colors">{chip.text}</a>
                      ) : (
                        <span tabindex="-1" class="conveyor-chip bg-ink text-inverse font-semibold">{chip.text}</span>
                      )
                    ) : chip.logo ? (
                      <span class={`conveyor-chip ${tintClasses[i % tintClasses.length]}`}>
                        {/* eager, not lazy: the belt sits just under the hero, so these are
                            in view immediately and lazy only delays them. It also matters for
                            the animation — a logo has no intrinsic width until it decodes, so
                            a late arrival widens its chip and changes the track width mid-run,
                            which shows up as a stutter in the belt. */}
                        <img src={chip.logo} alt={chip.text} class="h-10 w-auto object-contain" loading="eager" decoding="sync" />
                      </span>
                    ) : (
                      <span class={`conveyor-chip ${tintClasses[i % tintClasses.length]}`}>
                        <img src="/marva-mark.svg" alt="" class="w-4 h-4 opacity-40 grayscale" />
                        {chip.text}
                      </span>
                    )
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
      )}
    </section>
    )}

    <!-- ═══════════════ B. WHO ARE WE — FULL-SCREEN STATEMENT ═══════════════ -->
    {sections.home.who && (
    <section id="who" class="min-h-[70vh] flex items-center justify-center bg-sage-tint py-16">
      <!-- sage-tint here (not sand-tint): sage is Marva's dominant brand colour (45% of the
           palette) and was unused on the home page; #who is also the full-screen brand
           statement moment, a natural place to spend it. This keeps page rhythm alternating —
           hero bg-base -> who bg-sage-tint -> where bg-sand-tint -> big-buttons bg-surface ->
           upcoming bg-sand-tint -> inquiry bg-surface — so no two adjacent sections share a bg. -->
      <div class="max-w-3xl mx-auto px-6 text-center flex flex-col gap-6 w-full min-w-0">
        {whoStatement.lines.map((line, i) => (
          // Line 3 is the longest string and stays single-line from md up (below, it wraps
          // to 2 balanced lines instead). Its clamp maximum steps down to 3.25rem (vs line 2's
          // 3.5rem) so it fits the 720px usable width (max-w-3xl minus px-6) without bleeding
          // past the column at desktop widths.
          <p class={`who-line font-display font-bold text-ink leading-[1.2] text-balance ${i === 0 ? 'text-[clamp(2.25rem,4.5vw+1.1rem,4rem)]' : i === 2 ? 'text-[clamp(2rem,4vw+1rem,3.25rem)]' : 'text-[clamp(2rem,4vw+1rem,3.5rem)]'} ${i === 2 ? 'md:whitespace-nowrap' : ''}`}>
            {line}
          </p>
        ))}
      </div>
    </section>
    )}

    <!-- ═══════════════ D. WHERE DO WE WORK ═══════════════ -->
    {sections.home.where && (
    <section id="where" class="bg-sand-tint py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="where-heading font-display font-bold text-ink text-[clamp(1.75rem,3vw+0.5rem,3rem)] text-center">
          {whereHeading}
        </h2>
        <!-- flex, not a rigid column grid — rows with hidden cards stay centered -->
        <div class="flex flex-wrap justify-center gap-5 max-w-6xl mx-auto mt-12">
          {visible(whereCards).map((c) => (
            <ExpandCard id={`where-${c.key}`} triggerLabel={ui.moreDetailsLabel} class="where-card w-full sm:w-[calc(50%-0.625rem)] lg:w-[calc(33.333%-0.834rem)] bg-surface rounded-[20px] shadow-card overflow-hidden transition-[transform,box-shadow] duration-200 ease-out hover:-translate-y-1 shadow-card-hover">
              <div class="aspect-video w-full overflow-hidden">
                <img src={cardPhotoSrc[c.illustration]} alt={c.photoAlt} class="w-full h-full object-cover" loading="lazy" />
              </div>
              <div class="px-6 pt-6">
                <h3 class="font-display font-bold text-ink text-xl mb-2">{c.title}</h3>
                <p class="font-body text-ink/80">{c.body}</p>
              </div>
              <Fragment slot="expanded">
                <p class="font-body text-ink/80">{c.long}</p>
              </Fragment>
            </ExpandCard>
          ))}
        </div>
      </div>
    </section>
    )}

    <!-- ═══════════════ E. THREE BIG BUTTONS ═══════════════ -->
    {sections.home.bigButtons && (
    <section class="bg-surface py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="font-display font-bold text-ink text-[clamp(1.75rem,3vw+0.5rem,3rem)] text-center">{bigButtonsHeading}</h2>
        <div class="flex flex-wrap justify-center gap-5 max-w-4xl mx-auto mt-12">
          {visible(bigButtons).map((b) => (
            <a
              href={b.href}
              class={`group w-full md:w-[calc(33.333%-0.834rem)] flex flex-col items-center justify-center gap-4 py-10 px-6 rounded-[20px] text-center font-display font-bold text-lg text-ink transition-all duration-200 hover:-translate-y-1 ${bigButtonTints[b.tint].bg} ${bigButtonTints[b.tint].hover}`}
            >
              <span>{b.label}</span>
              <svg class="w-5 h-5 transition-transform duration-200 group-hover:-translate-x-1" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 10H4"></path>
                <path d="M9 4l-6 6 6 6"></path>
              </svg>
            </a>
          ))}
        </div>
      </div>
    </section>
    )}

    <!-- ═══════════════ F. TESTIMONIALS ═══════════════ -->
    {sections.home.testimonials && (
    <section id="testimonials" class="bg-surface py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="testimonials-heading font-display font-bold text-ink text-[clamp(1.75rem,3vw+0.5rem,3rem)] text-center">
          {testimonialsHeading}
        </h2>
        <div class="flex flex-wrap justify-center gap-5 max-w-5xl mx-auto mt-12">
          {visible(testimonials).map((t, i) => (
            <ExpandCard id={`testimonial-${i}`} triggerLabel={ui.readMoreLabel} class="testimonial-card w-full md:w-[calc(33.333%-0.834rem)] relative bg-surface rounded-[20px] shadow-card overflow-hidden border border-border">
              <div class="px-6 pt-6">
                <div class="flex items-start justify-between">
                  <span class="font-display text-5xl text-sage-deep leading-none" aria-hidden="true">”</span>
                  <Badge tone="sand">{t.badge}</Badge>
                </div>
                <p class="font-display font-bold text-ink mt-1">{t.name}</p>
                <p class="font-body text-ink/80 mt-2">{t.short}</p>
              </div>
              <Fragment slot="expanded">
                <p class="font-body text-ink/80">{t.long}</p>
              </Fragment>
            </ExpandCard>
          ))}
        </div>
      </div>
    </section>
    )}

    <!-- ═══════════════ G. UPCOMING DISTRIBUTION POINTS ═══════════════ -->
    {sections.home.upcoming && (
    <section id="upcoming" class="bg-sand-tint py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="font-display font-bold text-ink text-[clamp(1.75rem,3vw+0.5rem,3rem)] text-center">
          {findSpotsHeading}
        </h2>
        <div class="bg-surface rounded-[20px] shadow-card p-6 md:p-8 max-w-4xl mx-auto mt-12">
          <ul class="list-none p-0 m-0">
            {visible(findSpots).map((s) => (
              <li class="flex gap-4 items-center py-3.5 border-b border-border last:border-b-0">
                <span class="font-display font-bold text-sm text-sage-deep min-w-[72px]">{s.date}</span>
                <span class="font-body text-ink">{s.loc}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
    )}

    <!-- ═══════════════ H. GENERAL INQUIRY FORM ═══════════════ -->
    {sections.home.inquiry && (
    <section id="inquiry" class="bg-surface py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="font-display font-bold text-ink text-[clamp(1.75rem,3vw+0.5rem,3rem)] text-center">
          {inquiryForm.heading}
        </h2>

        <div class="bg-sand-tint rounded-[20px] shadow-card p-6 md:p-10 max-w-[640px] mx-auto mt-8">
          <form class="general-form marva-form" data-subject={inquiryForm.subject}>
            <input type="hidden" name="from_page" value={inquiryForm.fromPage} />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
              <Input label={inquiryForm.fields.name.label} name="name" placeholder={inquiryForm.fields.name.placeholder} required class="sm:col-span-2" />
              <Input label={inquiryForm.fields.email.label} name="email" type="email" dir="ltr" placeholder={inquiryForm.fields.email.placeholder} required />
              <Input label={inquiryForm.fields.phone.label} name="phone" type="tel" dir="ltr" placeholder={inquiryForm.fields.phone.placeholder} />
              <label class="flex flex-col gap-1.5 sm:col-span-2">
                <span class="form-label">{inquiryForm.fields.topicLabel}</span>
                <select name="topic" class="form-input">
                  {inquiryTopics.map((t) => <option value={t}>{t}</option>)}
                </select>
              </label>
              <label class="flex flex-col gap-1.5 sm:col-span-2">
                <span class="form-label">{inquiryForm.fields.message.label}</span>
                <textarea name="message" class="form-input" rows="5" required placeholder={inquiryForm.fields.message.placeholder}></textarea>
              </label>
            </div>
            <label class="flex gap-2 items-start cursor-pointer font-body text-sm text-ink mb-5">
              <input type="checkbox" name="privacy_consent" value="agreed" required class="mt-1" />
              <span>{ui.consentPre} <a href={privacyHref} target="_blank" rel="noopener" class="underline hover:text-sage-deep transition-colors">{ui.consentLinkLabel}</a></span>
            </label>
            <Button size="l" class="w-full" type="submit">{inquiryForm.fields.submitLabel}</Button>
          </form>
          <div class="form-thanks hidden text-center py-10 font-body text-lg text-sage-deep">{inquiryForm.thanks}</div>
          <div class="form-error hidden text-center py-4 font-body text-sm text-red-600">{inquiryForm.error}</div>
        </div>
      </div>
    </section>
    )}

  </main>

  <Footer locale={locale} page="home" />

  <script>
    import { animate, stagger } from 'motion';
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Hero Motion spring load — home page only */
    if (!reduced) {
      const heroCopyChildren = document.querySelectorAll<HTMLElement>('.hero-copy > *');
      const heroVisual = document.querySelector<HTMLElement>('.hero-visual');

      const springTransition = { type: 'spring' as const, stiffness: 260, damping: 24, mass: 0.9 };

      if (heroCopyChildren.length) {
        animate(
          heroCopyChildren,
          { opacity: [0, 1], y: [16, 0] },
          { delay: stagger(0.08), ...springTransition },
        );
      }

      if (heroVisual) {
        animate(
          heroVisual,
          { opacity: [0, 1], scale: [0.9, 1], y: [16, 0] },
          { delay: 0.15, ...springTransition },
        );
      }
    }

    /* Who-are-we stacked cascade — home #who only. 3 lines sit stacked
       normally (no pinning) and fade/slide in one after another as the
       section is scrolled to — not a `main h2` reveal (there's no h2 in
       #who at all, just 3 <p class="who-line">), so no exclusion is needed
       for it in shared.ts.

       Genuinely sequential, not a GSAP `stagger` (stagger only offsets each
       line's START by a fixed delta — with these durations the tweens still
       overlap in time, so lines 2 and 3 end up mid-fade together and read as
       "showing at once"). Each `+=0.3` position instead starts a line only
       after the PREVIOUS one has fully finished, so line 2 doesn't begin
       until line 1 has completely landed. */
    if (!reduced) {
      const whoSection = document.getElementById('who');
      const whoLines = document.querySelectorAll<HTMLElement>('.who-line');

      if (whoSection && whoLines.length) {
        const tl = gsap.timeline({
          scrollTrigger: { trigger: whoSection, start: 'top 70%', once: true },
        });

        whoLines.forEach((line, i) => {
          tl.from(
            line,
            { y: 24, opacity: 0, duration: 0.5, ease: 'power2.out', clearProps: 'transform' },
            i === 0 ? 0 : '+=0.3',
          );
        });
      }
    }
  </script>
</Layout>
