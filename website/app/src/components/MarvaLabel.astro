---
/**
 * MarvaLabel — true-proportion advertiser space demo, scroll-driven unroll.
 *
 * One strip at the real label's 210:42 print proportions (Emek HaMaayanot
 * 500ml, measured from the supplier print). Zone split measured from that
 * label with the mandatory content compressed to the right end:
 *
 *   left 9% (Marva mark) · center 50% (client ad zone) · right 41% (mandatory)
 *
 * The center panel pins mid-viewport; the side panels start tucked underneath
 * it and slide out to their true positions as the user scrolls — showing an
 * advertiser exactly how much of the label is theirs. Proportions are sacred;
 * fine print may be unreadably small at phone scale (it zooms crisply — HTML,
 * not raster). Without JS or with reduced motion the strip renders already
 * unrolled: the sides sit at their final CSS positions and only the animation
 * tucks them.
 *
 * ZONES here must stay in sync with the width/inset percentages in the
 * scoped <style> below.
 */

interface Props {
  /** Big text in the client zone (labelPromo.brandZonePlaceholder). */
  placeholder?: string;
  /** Screen-reader summary of the demo (labelPromo.ariaLabel). */
  ariaLabel?: string;
}
const {
  placeholder = 'המותג שלכם כאן',
  ariaLabel = 'הדמיה בפרופורציות אמיתיות של תווית הבקבוק: אזור המותג שלכם במרכז, תוכן החובה מימין וסמל מרווה משמאל',
} = Astro.props;

/* Minerals exactly as printed on the label (mg/liter). Formula strings are
   trusted static markup (<sub>/<sup> only) rendered via set:html. */
const minerals = [
  { he: 'דו פחמות', ar: 'بيكربونات', f: 'HCO<sub>3</sub><sup>-</sup>', v: '293' },
  { he: 'סידן', ar: 'كالسيوم', f: 'Ca<sup>+2</sup>', v: '84' },
  { he: 'מגנזיום', ar: 'مغنيسيوم', f: 'Mg<sup>+2</sup>', v: '30' },
  { he: 'כלורידים', ar: 'كلوريد', f: 'Cl<sup>-</sup>', v: '73' },
  { he: 'חנקות', ar: 'نترات', f: 'NO<sub>3</sub><sup>-</sup>', v: '15.2' },
  { he: 'סיליקטים', ar: 'سيليكات', f: 'SiO<sub>2</sub>', v: '9' },
  { he: 'נתרן', ar: 'صوديوم', f: 'Na<sup>+</sup>', v: '45' },
  { he: 'גפרות', ar: 'كبريتات', f: 'SO<sub>4</sub>', v: '9.7' },
  { he: 'אשלגן', ar: 'بوتاسيوم', f: 'K<sup>+</sup>', v: '3.18' },
  { he: 'פלואוריד', ar: 'فلورايد', f: 'F<sup>-</sup>', v: '0.33' },
  { he: 'ערך הגבה', ar: 'درجة الحموضة', f: 'pH', v: '7.8' },
];
---

<div class="mt-14" data-marva-label>
  <!-- The stage is what gets pinned: strip + breathing room, centered. -->
  <div class="flex justify-center py-8" data-label-stage>
    <div class="marva-label-track relative" role="img" aria-label={ariaLabel} dir="rtl">

      <!-- MARVA ZONE · physical-left 9%, starts under the client zone -->
      <div class="lbl-zone lbl-zone-marva absolute inset-y-0 left-0 z-10" data-label-panel="left" aria-hidden="true">
        <div class="lbl-mark-ring">
          <img src="/marva-mark.svg" alt="" />
        </div>
      </div>

      <!-- MANDATORY CONTENT · physical-right 41%, starts under the client zone -->
      <div class="lbl-zone lbl-zone-mandatory absolute inset-y-0 right-0 z-10" data-label-panel="right" aria-hidden="true">
        <div class="lbl-minerals">
          <div class="lbl-head">
            <span>מינרלים מ״ג/ליטר</span>
            <span lang="ar">المعادن ملغم/لتر</span>
          </div>
          <table class="lbl-table">
            <tbody>
              {minerals.map((m) => (
                <tr>
                  <td class="t-he">{m.he}</td>
                  <td class="t-ar" lang="ar">{m.ar}</td>
                  <td class="t-f" dir="ltr" set:html={m.f} />
                  <td class="t-v" dir="ltr">{m.v}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="lbl-reg">
          <div class="lbl-deposit font-display">חייב בפיקדון 30 אג׳</div>
          <div class="lbl-reg-line">
            <span>תכולה: <b dir="ltr">500</b> מ״ל</span>
            <span>כשר לפסח בהשגחת הרבנות</span>
          </div>
          <div class="lbl-marks" aria-hidden="true">
            <!-- resin code: PETE 1 -->
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M24 8 39 34.5H9L24 8Z" />
              <path d="M27 12.8 24 8l-4.6 2.6" />
              <path d="M12.2 29 9 34.5l5.6.6" />
              <path d="M33 34.5h6l-1.4-5.4" />
              <text x="24" y="30" text-anchor="middle" font-size="12" font-weight="700" fill="currentColor" stroke="none" font-family="Rubik, sans-serif">1</text>
            </svg>
            <!-- 100% recyclable roundel -->
            <svg viewBox="0 0 64 64" fill="none">
              <circle cx="32" cy="32" r="29" stroke="currentColor" stroke-width="2.5" />
              <defs>
                <path id="lbl-arc" d="M11 32a21 21 0 0 1 42 0" />
              </defs>
              <text font-size="8.5" letter-spacing="1.2" fill="currentColor" font-family="Rubik, sans-serif">
                <textPath href="#lbl-arc" startOffset="50%" text-anchor="middle">RECYCLABLE</textPath>
              </text>
              <text x="32" y="44" text-anchor="middle" font-size="13.5" font-weight="700" fill="currentColor" font-family="Rubik, sans-serif">100%</text>
            </svg>
            <!-- tidyman -->
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="17" cy="10" r="3.6" />
              <path d="M17 15v12l-4 12" />
              <path d="M17 19l10-3.4" />
              <path d="M29 21l2.6 4.4" />
              <path d="M29 27h11l-1.8 13h-7L29 27Z" />
            </svg>
          </div>
          <p class="lbl-fine">
            עדיף להשתמש לפני התאריך המוטבע · לשמור במקום מוצל ויבש
            <br />
            היצרן: עמק המעיינות מים מינרליים טבעיים בע״מ, קיבוץ שדה אליהו
          </p>
        </div>
      </div>

      <!-- CLIENT AD ZONE · its true home on the strip is [9%,59%] — directly
           after the mark zone, NOT the strip's middle; the script glides the
           whole track so this panel still starts viewport-centered. -->
      <div class="lbl-zone lbl-zone-client absolute inset-y-0 left-[9%] z-20" data-label-panel="center">
        <div class="lbl-client-frame">
          <span class="lbl-client-text font-display">{placeholder}</span>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  /* One var drives strip width AND the em type scale so the whole label
     scales as a single graphic at true 210:42 print proportions. */
  .marva-label-track {
    --strip-w: min(92vw, 1200px);
    width: var(--strip-w);
    aspect-ratio: 210 / 42;
    font-size: calc(var(--strip-w) / 100);
    /* keep mobile browsers from inflating the deliberately-tiny print */
    -webkit-text-size-adjust: none;
    text-size-adjust: none;
  }

  /* Zone widths — must stay in sync with ZONES in the <script>. */
  .lbl-zone {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.7em;
    box-shadow: 0 1px 2px rgba(17, 17, 17, 0.04), 0 8px 24px rgba(17, 17, 17, 0.06);
    overflow: hidden;
  }
  .lbl-zone-marva {
    width: 9%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lbl-zone-client {
    width: 50%;
    padding: 0.8em;
    /* pinned panel needs more lift so the sides read as sliding out from
       underneath it */
    box-shadow: 0 4px 10px rgba(17, 17, 17, 0.07), 0 20px 44px rgba(17, 17, 17, 0.13);
  }
  .lbl-zone-mandatory {
    width: 41%;
    display: flex;
    gap: 0.8em;
    padding: 0.8em;
  }

  /* ── Marva zone ── */
  .lbl-mark-ring {
    width: 6.4em;
    height: 6.4em;
    border: 0.09em solid rgba(17, 17, 17, 0.16);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lbl-mark-ring img {
    width: 3.2em;
    height: auto;
    display: block;
  }

  /* ── client ad zone ── */
  .lbl-client-frame {
    width: 100%;
    height: 100%;
    border: 0.18em dashed var(--color-sage-deep);
    border-radius: 0.5em;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lbl-client-text {
    font-weight: 700;
    font-size: 2.5em;
    color: var(--color-ink);
  }

  /* ── mandatory zone: minerals column (true ~30% of the zone) ── */
  .lbl-minerals {
    flex: 0 0 30%;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .lbl-head {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.5em;
    line-height: 1.3;
    color: var(--color-sky-deep);
    border-bottom: 0.15em solid var(--color-sky-deep);
    padding-bottom: 0.3em;
  }
  .lbl-table {
    /* stretch to the zone bottom — the extra height distributes across rows */
    flex: 1;
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-display);
    font-size: 0.45em;
    line-height: 1.2;
    color: var(--color-ink);
  }
  .lbl-table tr:nth-child(even) {
    background: var(--color-sky-tint);
  }
  .lbl-table td {
    padding: 0.1em 0.25em;
  }
  .t-ar {
    color: var(--color-muted);
  }
  .t-f {
    color: var(--color-sky-deep);
    font-weight: 600;
    text-align: start;
    white-space: nowrap;
  }
  .t-v {
    text-align: start;
    font-weight: 600;
    white-space: nowrap;
  }

  /* ── mandatory zone: deposit / kosher / recycling column ── */
  .lbl-reg {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    text-align: center;
    gap: 0.3em;
  }
  .lbl-deposit {
    border: 0.14em solid var(--color-ink);
    border-radius: 0.4em;
    padding: 0.25em 0.9em;
    font-weight: 700;
    font-size: 0.8em;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .lbl-reg-line {
    display: flex;
    gap: 1em;
    font-family: var(--font-display);
    font-size: 0.5em;
    color: var(--color-ink);
  }
  .lbl-marks {
    display: flex;
    align-items: center;
    gap: 1.2em;
    color: var(--color-sage-deep);
  }
  .lbl-marks svg {
    width: 2.3em;
    height: 2.3em;
  }
  .lbl-fine {
    font-family: var(--font-display);
    font-size: 0.42em;
    line-height: 1.45;
    color: var(--color-muted);
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const stage = document.querySelector<HTMLElement>('[data-label-stage]');
  const left = document.querySelector<HTMLElement>('[data-label-panel="left"]');
  const right = document.querySelector<HTMLElement>('[data-label-panel="right"]');

  if (stage && left && right) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced) {
      /* The strip tiles at true proportions: mark [0,9] · client [9,59] ·
         mandatory [59,100] (% of strip — must stay in sync with the CSS).
         Both sides start tucked exactly one own-width behind the client
         zone's edges (xPercent ±100) and slide to their tiled homes. The
         client zone's true center sits at 34% of the strip, so the whole
         track also glides 16% → 0: the client panel starts viewport-centered
         alone, and the finished strip ends viewport-centered — reads as the
         bottle rotating while the label unrolls. */
      const track = document.querySelector<HTMLElement>('.marva-label-track');

      gsap
        .timeline({
          defaults: { ease: 'none' },
          scrollTrigger: {
            trigger: stage,
            pin: true,
            start: 'center center',
            end: '+=600',
            scrub: 1,
            anticipatePin: 1,
          },
        })
        .fromTo(track, { xPercent: 16 }, { xPercent: 0 }, 0)
        .fromTo(left, { xPercent: 100 }, { xPercent: 0 }, 0)
        .fromTo(right, { xPercent: -100 }, { xPercent: 0 }, 0);

      /* Pin distances are measured at init; fonts/images that finish loading
         afterwards shift layout, so re-measure once everything is in. */
      window.addEventListener('load', () => ScrollTrigger.refresh());
    }
    /* reduced motion: nothing to do — the sides' static CSS positions ARE the
       unrolled end state; only the animation ever tucks them. */
  }
</script>
