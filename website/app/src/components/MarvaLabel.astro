---
/**
 * MarvaLabel — pixel-measured replica of the printed bottle label,
 * scroll-driven unroll.
 *
 * Source of truth: brand-book/שבלונה ואלי.pdf (supplier print file,
 * 823.94×136.06 pt), rasterized at 7500×1239 and measured. Geometry uses
 * em units where 1em = 1% of strip width (strip height = 16.52em). Ink
 * #2A3443, band #ACD2E6 — sampled from the scan. The בד"ץ / מיוצר בישראל
 * emblems and the recycling marks are actual crops from the print
 * (public/label/*.png), not redrawn.
 *
 * Zones: left 30% (logo circle, registration block, care texts, minerals
 * table, emblems) · blank middle 41.7% (the label's own empty area → CMS
 * placeholder) · right 28.3% (source block, deposit box with the black
 * recycling marks under it, trailing seam margin).
 *
 * The blank-middle panel pins mid-viewport; the printed clusters start
 * tucked underneath it (exactly one own-width: xPercent ±100) and slide
 * out on scroll. Without JS, with reduced motion, or with ?label-static
 * (QA screenshots) the strip renders already unrolled.
 *
 * Zone numbers must stay in sync between the <style> and the <script>.
 */

interface Props {
  /** Big text in the blank ad zone (labelPromo.brandZonePlaceholder). */
  placeholder?: string;
  /** Screen-reader summary of the demo (labelPromo.ariaLabel). */
  ariaLabel?: string;
}
const {
  placeholder = 'המותג שלכם כאן',
  ariaLabel = 'שחזור של תווית הבקבוק כפי שהיא מודפסת: תוכן החובה משני הצדדים — טבלת מינרלים, כשרות, פיקדון, מיחזור ופרטי היצרן — והאמצע הריק של התווית הוא אזור המותג שלכם',
} = Astro.props;

/* Minerals exactly as printed (mg/liter). Banded rows (Ca, Mg, Na, F) match
   the print's #ACD2E6 stripes. Formula strings are trusted static markup
   (<sub>/<sup> only) rendered via set:html. */
const minerals = [
  { he: 'דו פחמות', ar: 'بيكربونات', f: 'HCO<sub>3</sub>', v: '293', band: false },
  { he: 'סידן', ar: 'كالسيوم', f: 'Ca<sup>+2</sup>', v: '84', band: true },
  { he: 'מגנזיום', ar: 'مغنيسيوم', f: 'Mg<sup>+2</sup>', v: '30', band: true },
  { he: 'כלורידים', ar: 'كلوريد', f: 'Cl<sup>-</sup>', v: '73', band: false },
  { he: 'חנקות', ar: 'نترات', f: 'NO<sub>3</sub><sup>-</sup>', v: '15.2', band: false },
  { he: 'סיליקטים', ar: 'سيليكات', f: 'SiO<sub>2</sub>', v: '9', band: false },
  { he: 'נתרן', ar: 'صوديوم', f: 'Na<sup>+</sup>', v: '45', band: true },
  { he: 'גפרות', ar: 'كبريتات', f: 'SO<sub>4</sub><sup>-2</sup>', v: '9.7', band: false },
  { he: 'אשלגן', ar: 'بوتاسيوم', f: 'K<sup>+</sup>', v: '3.18', band: false },
  { he: 'פלואוריד', ar: 'فلورايد', f: 'F<sup>-</sup>', v: '0.33', band: true },
  { he: 'ערך הגבה', ar: 'درجة الحموضة', f: 'pH', v: '7.8', band: false },
];
---

<div class="mt-14" data-marva-label>
  <!-- The stage is what gets pinned: strip + breathing room, centered. -->
  <div class="marva-label-stage flex justify-center py-8" data-label-stage>
    <div class="marva-label-track relative" role="img" aria-label={ariaLabel} dir="rtl">

      <!-- LEFT CLUSTER · printed left region, tucks under the middle -->
      <div class="lbl-zone lbl-zone-left absolute inset-y-0 left-0 z-10" data-label-panel="left" aria-hidden="true">
        <div class="lbl-logo-circle">
          <img src="/marva-mark.svg" alt="" />
          <span dir="ltr">MARVA</span>
        </div>
        <div class="lbl-regmark"></div>

        <div class="lbl-care">
          <p class="lbl-bestbefore">
            <span class="lbl-arrow">↑</span>עדיף להשתמש לפני
            <br />
            <span lang="ar">يفضل الاستعمال قبل</span>
          </p>
          <p class="lbl-storage">
            לשמור במקום מוצל ויבש
            <br />
            <span lang="ar">للحفظ في مكان مظلل وجاف</span>
            <br />
            לשירותך, שירות צרכנים:
            <br />
            <span lang="ar">لخدمتك، خدمة العملاء</span>
            <br />
            <span class="lbl-phone" dir="ltr">04 - 3818881</span>
          </p>
          <p class="lbl-kosher">
            <b>כשר לפסח</b>
            <br />
            בהשגחת הרבנות
            <br />
            האזורית עמק המעיינות
          </p>
        </div>

        <!-- minerals table -->
        <div class="lbl-table-box">
          <div class="lbl-thead">
            <span>מינרלים<br />(מ״ג/ליטר)</span>
            <span lang="ar">المعادن<br />(ملغم/لتر)</span>
            <span dir="ltr">Minerals<br />(mg/liter)</span>
          </div>
          <table class="lbl-table">
            <tbody>
              {minerals.map((m) => (
                <tr class={m.band ? 'is-band' : ''}>
                  <td class="t-he">{m.he}</td>
                  <td class="t-ar" lang="ar">{m.ar}</td>
                  <td class="t-v" dir="ltr">{m.v}</td>
                  <td class="t-f" dir="ltr" set:html={m.f} />
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- kosher + made-in-israel emblems: actual crops from the print -->
        <img class="lbl-badatz" src="/label/badatz.png" alt="" />
        <img class="lbl-israel" src="/label/made-in-israel.png" alt="" />
      </div>

      <!-- BLANK MIDDLE · the label's own empty area = the client ad zone -->
      <div class="lbl-zone lbl-zone-client absolute inset-y-0 left-[30%] z-20" data-label-panel="center">
        <span class="lbl-client-text font-display">{placeholder}</span>
      </div>

      <!-- RIGHT CLUSTER · printed right region, tucks under the middle -->
      <div class="lbl-zone lbl-zone-right absolute inset-y-0 right-0 z-10" data-label-panel="right" aria-hidden="true">
        <div class="lbl-source">
          <p class="lbl-source-title">מי שתיה מעמק המעיינות</p>
          <p class="lbl-source-tag">ממקור תת קרקעי המכיל מינרלים טבעיים</p>
          <p class="lbl-source-ar" lang="ar">مياه شرب من وادي الينابيع، من مصدر جوفي غني بالمعادن الطبيعية</p>
          <p class="lbl-source-he">מי שתייה המכילים מינרלים טבעיים מופק ממקור תת קרקעי בין הרי הגלבוע לנהר הירדן השוכן בעמק המעיינות</p>
          <p class="lbl-contents">תכולה: <span dir="ltr">500 ML</span> מ״ל/<span lang="ar">مل</span></p>
          <p class="lbl-producer">
            היצרן: עמק המעיינות, מים מינרליים טבעיים בע״מ. קיבוץ שדה אליהו, עמק המעיינות.
            <br />
            <span lang="ar">المنتج: عيمك همعيانوت مياه معدنيه طبيعيه بع״م كيبوتس سدي الياهو، عيمك همعيانوت.</span>
          </p>
        </div>

        <div class="lbl-deposit">חייב<br />בפיקדון<br />30 אג׳</div>
        <!-- black recycling marks under the deposit box: actual crop from the print -->
        <img class="lbl-recycle" src="/label/recycle-marks.png" alt="" />
      </div>

    </div>
  </div>
</div>

<style>
  /* 1em = 1% of strip width; strip height = 16.52em (823.94:136.06 pts).
     Ink and fills sampled from the print scan.

     The stage is an inline-size container and the strip derives from cqw,
     NOT vw: the strip lives inside the section's max-w-6xl px-6 column, so
     a vw-based width gets flex-shrunk while font-size/--u would keep the
     unshrunk value — silently breaking the em↔width identity the whole
     geometry depends on. cqw is the actual available width, so
     width === 100 × --u at every viewport. */
  .marva-label-stage {
    container-type: inline-size;
  }
  .marva-label-track {
    --strip-w: min(92cqw, 1200px);
    /* geometry unit: 1u = 1% of strip width. Positioned elements that set
       their own font-size MUST use var(--u), not em — em offsets resolve
       against the element's own font-size. */
    --u: calc(var(--strip-w) / 100);
    --lbl-ink: #2a3443;
    --lbl-band: #acd2e6;
    width: var(--strip-w);
    aspect-ratio: 82394 / 13606;
    font-size: var(--u);
    font-family: var(--font-body);
    color: var(--lbl-ink);
    -webkit-text-size-adjust: none;
    text-size-adjust: none;
    /* One shadow for the whole composite: flush panels read as a single
       sheet of paper (no seams), separated panels still cast individually. */
    filter: drop-shadow(0 2px 3px rgba(17, 17, 17, 0.07)) drop-shadow(0 12px 22px rgba(17, 17, 17, 0.1));
  }

  /* Zone widths — must stay in sync with ZONES in the <script>. Borderless
     white paper like the print; the track-level drop-shadow gives the edge. */
  .lbl-zone {
    background: var(--color-surface);
    overflow: hidden;
  }
  .lbl-zone-left {
    width: 30%;
    border-radius: 0 0.35em 0.35em 0;
  }
  .lbl-zone-client {
    width: 41.7%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lbl-zone-right {
    width: 28.3%;
    border-radius: 0.35em 0 0 0.35em;
  }

  /* ── LEFT CLUSTER (positions measured off the scan, em = % strip) ── */
  .lbl-logo-circle {
    position: absolute;
    left: 1.4em;
    top: 0.9em;
    width: 7.4em;
    height: 7.4em;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0.12em 0.5em rgba(0, 0, 0, 0.18);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3em;
  }
  .lbl-logo-circle img {
    width: 3.5em;
    height: auto;
    display: block;
  }
  .lbl-logo-circle span {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.85em;
    letter-spacing: 0.12em;
    margin-inline-end: -0.12em;
    color: #111;
  }
  .lbl-regmark {
    position: absolute;
    left: 0.72em;
    top: 9.3em;
    width: 1.84em;
    height: 7.22em;
    background: #111;
  }

  .lbl-care {
    position: absolute;
    left: 8.8em;
    top: 0;
    bottom: 0;
    width: 9.7em;
    text-align: center;
  }
  .lbl-bestbefore {
    position: absolute;
    top: calc(0.75 * var(--u));
    width: 100%;
    font-size: 0.64em;
    font-weight: 600;
    line-height: 1.35;
  }
  .lbl-arrow {
    font-weight: 700;
    padding-inline-start: 0.2em;
  }
  .lbl-storage {
    position: absolute;
    top: calc(7.55 * var(--u));
    width: 100%;
    font-size: 0.6em;
    line-height: 1.33;
  }
  .lbl-phone {
    display: inline-block;
    font-weight: 600;
    letter-spacing: 0.28em;
    margin-top: 0.15em;
  }
  .lbl-kosher {
    position: absolute;
    top: calc(12.25 * var(--u));
    width: 100%;
    font-size: 0.6em;
    line-height: 1.28;
  }
  .lbl-kosher b {
    font-size: 1.45em;
  }

  .lbl-table-box {
    position: absolute;
    left: 18.83em;
    top: 0.75em;
    width: 10.44em;
    height: 11.31em;
    border: 0.09em solid var(--lbl-ink);
    border-radius: 0.3em;
    background: linear-gradient(180deg, #f7fafc, #e6f0f7);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .lbl-thead {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.25em 0.45em;
    border-bottom: 0.09em solid var(--lbl-ink);
    font-size: 0.5em;
    font-weight: 700;
    line-height: 1.15;
  }
  .lbl-thead [lang='ar'] {
    font-weight: 500;
  }
  .lbl-table {
    flex: 1;
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 0.5em;
    line-height: 1.1;
  }
  .lbl-table td {
    padding: 0.06em 0.35em;
    overflow: hidden;
  }
  .lbl-table tr.is-band {
    background: var(--lbl-band);
  }
  .t-he {
    font-weight: 700;
    width: 29%;
  }
  .t-ar {
    width: 27%;
    font-weight: 500;
  }
  .t-v {
    width: 18%;
    font-weight: 700;
    text-align: start;
    white-space: nowrap;
  }
  .t-f {
    width: 26%;
    text-align: start;
    white-space: nowrap;
  }

  .lbl-badatz {
    position: absolute;
    left: 18.7em;
    top: 12.37em;
    width: 6.56em;
    height: auto;
  }
  .lbl-israel {
    position: absolute;
    left: 25.7em;
    top: 12.2em;
    width: 4.24em;
    height: auto;
  }

  /* ── BLANK MIDDLE / CLIENT ZONE ── */
  .lbl-client-text {
    font-weight: 700;
    font-size: 2.4em;
    color: var(--color-ink);
  }

  /* ── RIGHT CLUSTER ── */
  .lbl-source {
    position: absolute;
    left: 0.3em; /* panel is 28.3em; column x 0.3–11.3em from panel left */
    width: 11em;
    top: 0.77em;
    text-align: justify;
    text-align-last: start;
  }
  .lbl-source p {
    margin: 0;
  }
  .lbl-source-title {
    font-size: 0.8em;
    font-weight: 800;
    line-height: 1.2;
  }
  .lbl-source-tag {
    font-size: 0.6em;
    font-weight: 700;
    line-height: 1.3;
  }
  .lbl-source-ar {
    font-size: 0.6em;
    line-height: 1.35;
  }
  .lbl-source-he {
    font-size: 0.56em;
    line-height: 1.3;
  }
  .lbl-contents {
    font-size: 0.66em;
    font-weight: 700;
    border-top: 0.07em solid var(--lbl-ink);
    border-bottom: 0.07em solid var(--lbl-ink);
    padding: 0.12em 0;
    margin: 0.25em 0 !important;
  }
  .lbl-producer {
    font-size: 0.56em;
    line-height: 1.3;
  }
  .lbl-producer [lang='ar'] {
    font-size: 1.04em;
  }

  .lbl-deposit {
    position: absolute;
    left: calc(12.01 * var(--u));
    top: calc(0.75 * var(--u));
    width: calc(8.29 * var(--u));
    height: calc(8.83 * var(--u));
    background: linear-gradient(160deg, #edf4fa, #dcebf5);
    border: 0.08em solid var(--lbl-ink);
    border-radius: 0.3em;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-weight: 700;
    font-size: 2.1em;
    line-height: 1.22;
  }
  .lbl-recycle {
    position: absolute;
    left: 11.89em;
    top: 9.13em;
    width: 8.67em;
    height: auto;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const stage = document.querySelector<HTMLElement>('[data-label-stage]');
  const left = document.querySelector<HTMLElement>('[data-label-panel="left"]');
  const right = document.querySelector<HTMLElement>('[data-label-panel="right"]');

  if (stage && left && right) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    /* ?label-static = QA escape for screenshot verification: render the
       final unrolled strip with no pin/animation. */
    const staticMode = new URLSearchParams(location.search).has('label-static');

    if (!reduced && !staticMode) {
      /* Zones tile at the scan's boundaries: left [0,30] · middle [30,71.7] ·
         right [71.7,100] (% of strip — keep in sync with the CSS). Both
         printed clusters sit adjacent to the middle, so tucking each flush
         behind the middle's edges is exactly one own-width: xPercent ±100.
         The middle's true center is at 50.85% of the strip, so the track
         also glides -0.85% → 0 to keep the lone middle panel
         viewport-centered at the start. */
      const track = document.querySelector<HTMLElement>('.marva-label-track');

      gsap
        .timeline({
          defaults: { ease: 'none' },
          scrollTrigger: {
            trigger: stage,
            pin: true,
            start: 'center center',
            end: '+=600',
            scrub: 1,
            anticipatePin: 1,
          },
        })
        .fromTo(track, { xPercent: -0.85 }, { xPercent: 0 }, 0)
        .fromTo(left, { xPercent: 100 }, { xPercent: 0 }, 0)
        .fromTo(right, { xPercent: -100 }, { xPercent: 0 }, 0);

      /* Pin distances are measured at init; fonts/images that finish loading
         afterwards shift layout, so re-measure once everything is in. */
      window.addEventListener('load', () => ScrollTrigger.refresh());
    }
    /* reduced motion / static mode: nothing to do — the clusters' static CSS
       positions ARE the unrolled label; only the animation ever tucks them. */
  }
</script>
