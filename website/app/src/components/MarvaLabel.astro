---
/**
 * MarvaLabel — pixel-measured replica of the printed bottle label,
 * scroll-driven unroll.
 *
 * Source of truth: brand-book/שבלונה ואלי.pdf (supplier print file,
 * 823.94×136.06 pt), rasterized at 7500×1239 and measured. Geometry uses
 * em units where 1em = 1% of strip width (strip height = 16.52em). Ink
 * #2A3443, band #ACD2E6 — sampled from the scan. The בד"ץ / מיוצר בישראל
 * emblems and the recycling marks are actual crops from the print
 * (public/label/*.png), not redrawn.
 *
 * Zones: left 30% (logo circle, registration block, care texts, minerals
 * table, emblems) · blank middle 41.7% (the label's own empty area → CMS
 * placeholder) · right 28.3% (source block, deposit box with the black
 * recycling marks under it, trailing seam margin).
 *
 * The blank-middle panel pins mid-viewport; the printed clusters start
 * tucked underneath it (exactly one own-width: xPercent ±100) and slide
 * out on scroll. Without JS, with reduced motion, or with ?label-static
 * (QA screenshots) the strip renders already unrolled.
 *
 * Below 768px the strip is rotated 90° (plain CSS, unconditional — not
 * JS-gated) so its long axis runs down the phone's portrait screen
 * instead of across its width: a 6.055:1 strip fits a phone's height far
 * better than its width, so this gets both a bigger base unit AND the
 * whole label visible at once — an earlier revision panned across an
 * oversized strip instead and could only ever get one of those two, plus
 * the right cluster was never reachable on a touch screen. The rotation
 * lives on a wrapper around .marva-label-track, never on the track
 * itself — see the <style>/<script> for why. The scroll-driven unroll
 * below is otherwise unchanged; it just reads as a vertical slide once
 * rotated, since the zones' local x becomes screen y.
 *
 * Zone numbers must stay in sync between the <style> and the <script>.
 *
 * Marva is a white-label advertiser, not the bottler, so nothing here may
 * name or point to the actual manufacturer: the producer's name and
 * address, the consumer-service phone number, the kosher supervising
 * body, and the source's place names are all redacted, each character
 * swapped for a plain ASCII hyphen. The hyphen run for each redacted word
 * is deliberately the same length as the real word it replaces, because
 * these text blocks are justified to fill ink bands measured off the
 * supplier print — a short placeholder would leave a visible gap where
 * the print has none. Matching the character count is not the same as
 * matching the width, though: the hyphen comes from Work Sans while the
 * Hebrew it stands in for comes from Assistant, and it measures about 11%
 * wider, so a redacted block can run slightly taller than the printed
 * original. Measured at the current sizes that costs the producer column
 * 8px, which still clears the bottom of its panel by 11px, and the kosher
 * block sits 18px clear — check that slack again before lengthening any
 * run. The genuine values live only in the supplier print file
 * (brand-book/שבלונה ואלי.pdf) and must never be copied back in here.
 */

interface Props {
  /** Big text in the blank ad zone (labelPromo.brandZonePlaceholder). */
  placeholder?: string;
  /** Screen-reader summary of the demo (labelPromo.ariaLabel). */
  ariaLabel?: string;
}
const {
  placeholder = 'המותג שלכם כאן',
  ariaLabel = 'שחזור של תווית הבקבוק כפי שהיא מודפסת: תוכן החובה משני הצדדים - טבלת מינרלים, כשרות, פיקדון, מיחזור ופרטי יצרן המוסתרים בהדגמה - והאמצע הריק של התווית הוא אזור המותג שלכם',
} = Astro.props;

/* Minerals exactly as printed (mg/liter). Banded rows (Ca, Mg, Na, F) match
   the print's #ACD2E6 stripes. Formula strings are trusted static markup
   (<sub>/<sup> only) rendered via set:html. */
const minerals = [
  { he: 'דו פחמות', ar: 'بيكربونات', f: 'HCO<sub>3</sub>', v: '293', band: false },
  { he: 'סידן', ar: 'كالسيوم', f: 'Ca<sup>+2</sup>', v: '84', band: true },
  { he: 'מגנזיום', ar: 'مغنيسيوم', f: 'Mg<sup>+2</sup>', v: '30', band: true },
  { he: 'כלורידים', ar: 'كلوريد', f: 'Cl<sup>-</sup>', v: '73', band: false },
  { he: 'חנקות', ar: 'نترات', f: 'NO<sub>3</sub><sup>-</sup>', v: '15.2', band: false },
  { he: 'סיליקטים', ar: 'سيليكات', f: 'SiO<sub>2</sub>', v: '9', band: false },
  { he: 'נתרן', ar: 'صوديوم', f: 'Na<sup>+</sup>', v: '45', band: true },
  { he: 'גפרות', ar: 'كبريتات', f: 'SO<sub>4</sub><sup>-2</sup>', v: '9.7', band: false },
  { he: 'אשלגן', ar: 'بوتاسيوم', f: 'K<sup>+</sup>', v: '3.18', band: false },
  { he: 'פלואוריד', ar: 'فلورايد', f: 'F<sup>-</sup>', v: '0.33', band: true },
  { he: 'ערך הגבה', ar: 'درجة الحموضة', f: 'pH', v: '7.8', band: false },
];
---

<div class="mt-14" data-marva-label>
  <!-- The stage is what gets pinned: strip + breathing room, centered. -->
  <div class="marva-label-stage flex justify-center py-8" data-label-stage>
    <!-- Mobile-only 90deg rotation (plain CSS, see <style>) lives on this
         wrapper, never on .marva-label-track itself: GSAP owns the
         track's `transform` wholesale for the unroll tween below and
         would clobber a rotate() set on that same element. -->
    <div class="marva-label-rotate">
      <div class="marva-label-track relative" role="img" aria-label={ariaLabel} dir="rtl">

      <!-- LEFT CLUSTER · printed left region, tucks under the middle -->
      <div class="lbl-zone lbl-zone-left absolute inset-y-0 left-0 z-10" data-label-panel="left" aria-hidden="true">
        <div class="lbl-logo-circle">
          <img src="/marva-mark.svg" alt="" />
          <span dir="ltr">MARVA</span>
        </div>
        <div class="lbl-regmark"></div>

        <div class="lbl-care">
          <p class="lbl-bestbefore">
            <span class="lbl-arrow">↑</span>עדיף להשתמש לפני
            <br />
            <span lang="ar">يفضل الاستعمال قبل</span>
          </p>
          <p class="lbl-storage">
            לשמור במקום מוצל ויבש
            <br />
            <span lang="ar">للحفظ في مكان مظلل وجاف</span>
            <br />
            לשירותך, שירות צרכנים:
            <br />
            <span lang="ar">لخدمتك، خدمة العملاء</span>
            <br />
            <span class="lbl-phone" dir="ltr">-- - -------</span>
          </p>
          <p class="lbl-kosher">
            <b>כשר לפסח</b>
            <br />
            בהשגחת ------
            <br />
            ------- --- --------
          </p>
        </div>

        <!-- minerals table -->
        <div class="lbl-table-box">
          <div class="lbl-thead">
            <span>מינרלים<br />(מ״ג/ליטר)</span>
            <span lang="ar">المعادن<br />(ملغم/لتر)</span>
            <span dir="ltr">Minerals<br />(mg/liter)</span>
          </div>
          <table class="lbl-table">
            <tbody>
              {minerals.map((m) => (
                <tr class={m.band ? 'is-band' : ''}>
                  <td class="t-he">{m.he}</td>
                  <td class="t-ar" lang="ar">{m.ar}</td>
                  <td class="t-v" dir="ltr">{m.v}</td>
                  <td class="t-f" dir="ltr" set:html={m.f} />
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- kosher + made-in-israel emblems: actual crops from the print -->
        <img class="lbl-badatz" src="/label/badatz.png" alt="" />
        <img class="lbl-israel" src="/label/made-in-israel.png" alt="" />
      </div>

      <!-- BLANK MIDDLE · the label's own empty area = the client ad zone -->
      <div class="lbl-zone lbl-zone-client absolute inset-y-0 left-[30%] z-20" data-label-panel="center">
        <span class="lbl-client-text font-display">{placeholder}</span>
      </div>

      <!-- RIGHT CLUSTER · printed right region, tucks under the middle -->
      <div class="lbl-zone lbl-zone-right absolute inset-y-0 right-0 z-10" data-label-panel="right" aria-hidden="true">
        <div class="lbl-source">
          <p class="lbl-source-title">מי שתיה ---- --------</p>
          <p class="lbl-source-tag">ממקור תת קרקעי המכיל מינרלים טבעיים</p>
          <p class="lbl-source-ar" lang="ar">مياه شرب من ---- --------، من مصدر جوفي غني بالمعادن الطبيعية</p>
          <p class="lbl-source-he">מי שתייה המכילים מינרלים טבעיים מופק ממקור תת קרקעי בין --- ------ ---- ----- השוכן ---- --------</p>
          <p class="lbl-contents">תכולה: <span dir="ltr">500 ML</span> מ״ל/<span lang="ar">مل</span></p>
          <p class="lbl-producer">
            היצרן: --- --------, --- -------- ------ ----. ----- --- -----, --- --------.
            <br />
            <span lang="ar">المنتج: ---- -------- ---- ------ ------ ---- ------ --- ------، ---- --------.</span>
          </p>
        </div>

        <div class="lbl-deposit">חייב<br />בפיקדון<br />30 אג׳</div>
        <!-- black recycling marks under the deposit box: actual crop from the print -->
        <img class="lbl-recycle" src="/label/recycle-marks.png" alt="" />
      </div>

      </div>
    </div>
  </div>
</div>

<style>
  /* 1em = 1% of strip width; strip height = 16.52em (823.94:136.06 pts).
     Ink and fills sampled from the print scan.

     The stage is an inline-size container and the strip derives from cqw,
     NOT vw: the strip lives inside the section's max-w-6xl px-6 column, so
     a vw-based width gets flex-shrunk while font-size/--u would keep the
     unshrunk value — silently breaking the em↔width identity the whole
     geometry depends on. cqw is the actual available width, so
     width === 100 × --u at every viewport.

     Below 768px --strip-w switches to svh instead (see the mobile block
     below): the strip is rotated there, so it's viewport HEIGHT, not the
     stage's inline width, that it has to fit. That does not reopen the
     hazard above — svh is a viewport unit exactly like the vw this
     paragraph warns against, but what actually prevented the shrink was
     never cqw itself, it was flex-shrink: 0 (below, and on the
     .marva-label-rotate wrapper in the mobile block): cqw only ever
     dodged the question because the container's resolved size already
     matched the unshrunk width. flex-shrink: 0 answers it directly for
     any unit, which is what makes svh safe here too. */
  .marva-label-stage {
    container-type: inline-size;
  }
  .marva-label-track {
    --strip-w: min(100cqw, 1200px);
    /* geometry unit: 1u = 1% of strip width. Positioned elements that set
       their own font-size MUST use var(--u), not em — em offsets resolve
       against the element's own font-size. */
    --u: calc(var(--strip-w) / 100);
    --lbl-ink: #2a3443;
    --lbl-band: #acd2e6;
    width: var(--strip-w);
    aspect-ratio: 82394 / 13606;
    font-size: var(--u);
    font-family: var(--font-body);
    color: var(--lbl-ink);
    -webkit-text-size-adjust: none;
    text-size-adjust: none;
    /* Below 768px the track's width no longer matches the stage's own
       (cqw) size — see the mobile block below — so it must never
       flex-shrink back down to fit, or the whole point of sizing it off
       the viewport is lost. No-op on desktop, where the track always
       already fits its flex container by construction. */
    flex-shrink: 0;
    /* One shadow for the whole composite: flush panels read as a single
       sheet of paper (no seams), separated panels still cast individually. */
    filter: drop-shadow(0 2px 3px rgba(17, 17, 17, 0.07)) drop-shadow(0 12px 22px rgba(17, 17, 17, 0.1));
  }

  /* ── MOBILE (<768px) ──────────────────────────────────────────────────
     Rotated 90°: the strip's own (long) axis then runs down the screen's
     (long) portrait axis instead of across its (short) width. A 6.055:1
     strip fits a phone's HEIGHT far better than its width, so this wins
     on two fronts a straight resize can't: a bigger base unit AND the
     entire label visible at once, nothing left off-screen (an earlier
     revision panned across an oversized strip instead of rotating and
     could only ever get one of those two — plus the right cluster was
     never reachable at all on a touch screen). The fine print stays
     illegible at any mobile size regardless (the minerals table is
     ~3.6px even at the strip width set below) — readers read the label's
     shape, not its copy, so nothing further is lost.
     .marva-label-rotate is a plain wrapper around .marva-label-track,
     never the track itself: GSAP owns the track's `transform` wholesale
     for the unroll tween in the <script> below and would clobber a CSS
     rotate() set on that same element. A wrapper keeps the two transform
     owners on separate elements and needs no GSAP changes at all. */
  @media (max-width: 767px) {
    .marva-label-stage {
      min-height: 100svh;
      align-items: center;
      /* The wrapper's un-rotated LAYOUT box (see below) is still ~715px
         wide even though it only paints ~118px wide once rotated — clip
         it here so that layout width can't push a horizontal scrollbar
         onto the page. This clips against the transformed (rotated)
         rendering, not the pre-transform layout box, so the actual
         visible strip — comfortably inside the stage on both axes — is
         never itself cut off. Unconditional: with the whole label always
         fully visible after rotation, there's nothing left to reach by
         scrolling, in any mode (animated, reduced-motion, ?label-static,
         or no JS at all) — so unlike the panning approach this needed
         before, no overflow-x escape hatch is needed either. */
      overflow: hidden;
    }
    .marva-label-track {
      /* Driven by viewport HEIGHT, not width, because rotated the strip's
         own width runs down the screen. svh (small-viewport height, immune
         to a collapsing mobile address bar resizing things mid-scroll) is
         the binding constraint. 88% leaves ~6% clear top and bottom so the
         strip never touches the screen edges; 900px caps it on unusually
         tall mobile viewports. At 375×812 this resolves to ~715px
         (--u ≈ 7.15px — more than double the old cqw-based ~3.27px),
         painting ~118px wide once .marva-label-rotate below rotates it. */
      --strip-w: min(88svh, 900px);
    }
    .marva-label-rotate {
      /* This wrapper, not the track, is the actual flex item inside
         .marva-label-stage now — same shrink hazard as .marva-label-track
         above, one level up. It must render at its full un-rotated size
         (matching the track it wraps exactly, since it has no sizing of
         its own) for the rotation below to land centered and correctly
         proportioned; letting flex shrink it would undersize the whole
         strip. */
      flex-shrink: 0;
      /* Clockwise: CSS rotate() on the browser's y-down screen axis maps
         a point at the element's LEFT edge, (-1, 0), to (0, -1) — its TOP
         (matrix x'=x·cos θ−y·sin θ, y'=x·sin θ+y·cos θ; at θ=90°,
         (-1,0) → (0,-1)). .lbl-zone-left — the MARVA wordmark and the
         minerals table — sits at the track's physical left edge, so this
         is what puts the logo at the top of the screen as the natural
         reading entry point. */
      transform: rotate(90deg);
    }
  }

  /* Zone widths — must stay in sync with ZONES in the <script>. Borderless
     white paper like the print; the track-level drop-shadow gives the edge. */
  .lbl-zone {
    background: var(--color-surface);
    overflow: hidden;
  }
  .lbl-zone-left {
    width: 30%;
    border-radius: 0 0.35em 0.35em 0;
  }
  .lbl-zone-client {
    width: 41.7%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lbl-zone-right {
    width: 28.3%;
    border-radius: 0.35em 0 0 0.35em;
  }

  /* ── LEFT CLUSTER (positions measured off the scan, em = % strip) ── */
  .lbl-logo-circle {
    position: absolute;
    left: 1.4em;
    top: 0.9em;
    width: 7.4em;
    height: 7.4em;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0.12em 0.5em rgba(0, 0, 0, 0.18);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3em;
  }
  .lbl-logo-circle img {
    width: 3.5em;
    height: auto;
    display: block;
  }
  .lbl-logo-circle span {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.85em;
    letter-spacing: 0.12em;
    margin-inline-end: -0.12em;
    color: #111;
  }
  .lbl-regmark {
    position: absolute;
    left: 0.72em;
    top: 9.3em;
    width: 1.84em;
    height: 7.22em;
    background: #111;
  }

  .lbl-care {
    position: absolute;
    left: 8.8em;
    top: 0;
    bottom: 0;
    width: 9.7em;
    text-align: center;
  }
  .lbl-bestbefore {
    position: absolute;
    top: calc(0.75 * var(--u));
    width: 100%;
    font-size: 0.64em;
    font-weight: 600;
    line-height: 1.35;
  }
  .lbl-arrow {
    font-weight: 700;
    padding-inline-start: 0.2em;
  }
  .lbl-storage {
    position: absolute;
    top: calc(7.55 * var(--u));
    width: 100%;
    font-size: 0.6em;
    line-height: 1.33;
  }
  .lbl-phone {
    display: inline-block;
    font-weight: 600;
    letter-spacing: 0.28em;
    margin-top: 0.15em;
  }
  .lbl-kosher {
    position: absolute;
    top: calc(12.25 * var(--u));
    width: 100%;
    font-size: 0.6em;
    line-height: 1.28;
  }
  .lbl-kosher b {
    font-size: 1.45em;
  }

  .lbl-table-box {
    position: absolute;
    left: 18.83em;
    top: 0.75em;
    width: 10.44em;
    height: 11.31em;
    border: 0.09em solid var(--lbl-ink);
    border-radius: 0.3em;
    background: linear-gradient(180deg, #f7fafc, #e6f0f7);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .lbl-thead {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.25em 0.45em;
    border-bottom: 0.09em solid var(--lbl-ink);
    font-size: 0.5em;
    font-weight: 700;
    line-height: 1.15;
  }
  .lbl-thead [lang='ar'] {
    font-weight: 500;
  }
  .lbl-table {
    flex: 1;
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 0.5em;
    line-height: 1.1;
  }
  .lbl-table td {
    padding: 0.06em 0.35em;
    overflow: hidden;
  }
  .lbl-table tr.is-band {
    background: var(--lbl-band);
  }
  .t-he {
    font-weight: 700;
    width: 29%;
  }
  .t-ar {
    width: 27%;
    font-weight: 500;
  }
  .t-v {
    width: 18%;
    font-weight: 700;
    text-align: start;
    white-space: nowrap;
  }
  .t-f {
    width: 26%;
    text-align: start;
    white-space: nowrap;
  }

  .lbl-badatz {
    position: absolute;
    left: 18.7em;
    top: 12.37em;
    width: 6.56em;
    height: auto;
  }
  .lbl-israel {
    position: absolute;
    left: 25.7em;
    top: 12.2em;
    width: 4.24em;
    height: auto;
  }

  /* ── BLANK MIDDLE / CLIENT ZONE ── */
  .lbl-client-text {
    font-weight: 700;
    font-size: 2.4em;
    color: var(--color-ink);
  }

  /* ── RIGHT CLUSTER ── */
  /* Type sizes fitted to the print's measured ink bands (title 0.73–1.89em,
     tag 2.16–2.93, arabic →5.2, hebrew →7.69, contents rules 7.93–9.40,
     producer he →12.04, producer ar →15.27): the column runs the label's
     full height like the print. Block gaps/padding use var(--u) — em margins
     on font-sized blocks would resolve against their own size. */
  .lbl-source {
    position: absolute;
    left: 0.3em; /* panel is 28.3em; column x 0.3–11.3em from panel left */
    width: 11em;
    top: 0.45em;
    text-align: justify;
    text-align-last: start;
  }
  /* Print stretches its single-line blocks (title, tag, contents bar)
     wall-to-wall — justify their lone last line too. */
  .lbl-source-title {
    margin: 0;
    font-size: 1em;
    font-weight: 800;
    line-height: 1.16;
    text-align-last: justify;
  }
  .lbl-source-tag {
    margin: calc(0.35 * var(--u)) 0 0;
    font-size: 0.62em;
    font-weight: 700;
    line-height: 1.15;
    text-align-last: justify;
  }
  .lbl-source-ar {
    margin: calc(0.39 * var(--u)) 0 0;
    font-size: 0.68em;
    line-height: 1.3;
  }
  .lbl-source-he {
    margin: calc(0.42 * var(--u)) 0 0;
    font-size: 0.62em;
    line-height: 1.29;
  }
  .lbl-contents {
    margin: calc(0.24 * var(--u)) 0 0;
    font-size: 0.85em;
    font-weight: 700;
    border-top: 0.07em solid var(--lbl-ink);
    border-bottom: 0.07em solid var(--lbl-ink);
    padding: calc(0.07 * var(--u)) 0;
    text-align-last: justify;
  }
  .lbl-producer {
    margin: 0;
    font-size: 0.78em;
    line-height: 1.15;
  }
  .lbl-producer [lang='ar'] {
    display: inline-block;
    margin-top: calc(0.22 * var(--u));
    font-size: 0.96em;
    line-height: 1.42;
  }

  .lbl-deposit {
    position: absolute;
    left: calc(12.01 * var(--u));
    top: calc(0.75 * var(--u));
    width: calc(8.29 * var(--u));
    height: calc(8.83 * var(--u));
    background: linear-gradient(160deg, #edf4fa, #dcebf5);
    border: 0.08em solid var(--lbl-ink);
    border-radius: 0.3em;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-weight: 700;
    font-size: 2.1em;
    line-height: 1.22;
  }
  .lbl-recycle {
    position: absolute;
    left: 11.89em;
    top: 9.13em;
    width: 8.67em;
    height: auto;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const stage = document.querySelector<HTMLElement>('[data-label-stage]');
  const left = document.querySelector<HTMLElement>('[data-label-panel="left"]');
  const right = document.querySelector<HTMLElement>('[data-label-panel="right"]');

  if (stage && left && right) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    /* ?label-static = QA escape for screenshot verification: render the
       final unrolled strip with no pin/animation. */
    const staticMode = new URLSearchParams(location.search).has('label-static');

    if (!reduced && !staticMode) {
      /* Zones tile at the scan's boundaries: left [0,30] · middle [30,71.7] ·
         right [71.7,100] (% of strip — keep in sync with the CSS). Both
         printed clusters sit adjacent to the middle, so tucking each flush
         behind the middle's edges is exactly one own-width: xPercent ±100.
         The middle's true center is at 50.85% of the strip, so the track
         also glides -0.85% → 0 to keep the lone middle panel
         viewport-centered at the start. Identical on mobile: the CSS
         rotation lives on a separate wrapper (see <style>), so this still
         runs unmodified there — it just reads as a vertical slide instead
         of a horizontal one, since the zones' local x becomes screen y. */
      const track = document.querySelector<HTMLElement>('.marva-label-track');

      gsap
        .timeline({
          defaults: { ease: 'none' },
          scrollTrigger: {
            trigger: stage,
            pin: true,
            start: 'center center',
            end: '+=600',
            scrub: 1,
            anticipatePin: 1,
            /* Pin distance depends on measured layout, not just fixed
               values; invalidate on refresh so a late-loading font/image
               (or a resize) doesn't leave it stale. */
            invalidateOnRefresh: true,
          },
        })
        .fromTo(track, { xPercent: -0.85 }, { xPercent: 0 }, 0)
        .fromTo(left, { xPercent: 100 }, { xPercent: 0 }, 0)
        .fromTo(right, { xPercent: -100 }, { xPercent: 0 }, 0);

      /* Pin distances are measured at init; fonts/images that finish loading
         afterwards shift layout, so re-measure once everything is in. */
      window.addEventListener('load', () => ScrollTrigger.refresh());
    }
    /* reduced motion / static mode: nothing to do — the clusters' static CSS
       positions ARE the unrolled label; only the animation ever tucks them.
       The mobile rotation is plain, unconditional CSS (not JS-gated), so it
       still applies here too, and with the whole label already visible
       there's nothing further needed for either mode to stay reachable. */
  }
</script>
