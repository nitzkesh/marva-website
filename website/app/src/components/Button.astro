---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'm' | 'l';
  href?: string;
  class?: string;
  [key: string]: any;
}

const { variant = 'primary', size = 'm', href, class: className, ...rest } = Astro.props;

const base = 'rounded-full font-body font-semibold transition-all duration-150 inline-flex items-center justify-center';

// text-[1rem], not text-base: --color-base exists in @theme, so Tailwind v4
// compiles `text-base` to color:var(--color-base) (#FBFAF6) instead of a font
// size. It has been harmless only because every Button on the site is the
// primary variant, whose text-inverse is the SAME hex — on a secondary or
// ghost button it would have painted near-white text on a light background.
const sizes = {
  m: 'px-[22px] py-3 text-[1rem]',
  l: 'px-7 py-4 text-lg',
};

const variants = {
  primary: 'bg-ink text-inverse border border-ink hover:bg-[#2B2B2B] hover:-translate-y-px',
  secondary: 'bg-transparent text-ink border border-ink hover:bg-sage-tint hover:-translate-y-px',
  ghost: 'bg-transparent text-ink border border-transparent hover:bg-sage-tint hover:-translate-y-px',
};

const classes = [base, sizes[size] || sizes.m, variants[variant] || variants.primary, className]
  .filter(Boolean)
  .join(' ');
---

{href ? (
  <a href={href} class={classes} {...rest}>
    <slot />
  </a>
) : (
  <button class={classes} {...rest}>
    <slot />
  </button>
)}
