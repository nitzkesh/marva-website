---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { getContent, altLocaleHref, canonicalHref, visible, locales, localeNames, type Locale, type PageKey } from '../data/content';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const { navLinks, headerContent, miluim } = getContent(locale);

const homeHref = canonicalHref('home', locale);
/** Restated on the badge and CTA because their shared wrapper is forced to
    dir="ltr" for physical placement — see the comment on that wrapper. */
const dir = locale === 'he' ? 'rtl' : 'ltr';
/* Logo placement, derived rather than guessed. The logo is centred in the
   CONTAINER, but the clusters flanking it are very unequal now that the globe
   is gone - hamburger 40px against badge+CTA ~168px on /en/ - so plain
   centring walks it into the right cluster on narrow screens.

   Padding on the ANCHOR shifts the logo left by half its value, so a padding
   of exactly (groupWidth - leftWidth) re-centres the logo in the gap BETWEEN
   the clusters. That difference is a constant per locale - the CTA label does
   not reflow - which is why one value works at every width, where the fixed
   guess it replaced did not. Measured: /en/ 167.8 - 40 => 128px, HE 134.3 - 40
   => 94px.

   Above 2*group + logo + 2*padding, plain centring already clears both
   clusters and the shift is dropped: 496px on /en/, 400px on HE. Below 360px
   /en/ cannot fit hamburger + wordmark + badge + "Contact us" at all (they sum
   to 331px of a 328px content box), so only there does the wordmark give way
   to the bare mark; Hebrew is narrower and keeps its wordmark down to 320px.
   Re-measure all four numbers if the CTA label or the badge size changes. */
const logoShift = locale === 'en' ? 'pr-[128px] min-[496px]:pr-0' : 'pr-[94px] min-[400px]:pr-0';
const wordmarkClass = locale === 'en' ? 'max-[359px]:hidden' : '';
---

<!-- ═══════════════════ HEADER ═══════════════════ -->
<header class="site-header sticky top-0 z-50 bg-base/85 backdrop-blur-sm border-b border-border transition-shadow">
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 h-16 md:h-20 flex items-center">
    <!-- Hamburger: fixed physical LEFT at all sizes (Freewater-style). The
         globe/language button used to sit beside it; it was removed to buy
         ~44px of header width back for the wordmark on phones, and the two
         locale links moved into the nav overlay below. -->
    <div class="absolute left-0 flex items-center">
      <!-- Hamburger: opens full-screen overlay -->
      <button
        id="hamburger"
        type="button"
        aria-label={headerContent.menuAriaLabel}
        aria-expanded="false"
        aria-controls="nav-overlay"
        class="flex flex-col justify-center items-center gap-[6px] w-10 h-10 z-10 cursor-pointer"
      >
        <span class="hamburger-line block w-6 h-[2px] bg-ink rounded-full origin-center transition-transform duration-300"></span>
        <span class="hamburger-line block w-6 h-[2px] bg-ink rounded-full origin-center transition-opacity duration-200"></span>
        <span class="hamburger-line block w-6 h-[2px] bg-ink rounded-full origin-center transition-transform duration-300"></span>
      </button>
    </div>

    <!-- See logoShift / wordmarkClass in the frontmatter for why these are
         locale-specific and where the numbers come from. -->
    <a href={homeHref} class:list={['mx-auto', logoShift]} aria-label={headerContent.logoAriaLabel}>
      <Logo size="sm" locale={locale} textClass={wordmarkClass} />
    </a>

    <!-- Reservist-owned-business credential + CTA, anchored as one group.
         dir="ltr" is on the GROUP only, so DOM order maps to physical
         left->right and the badge lands inboard of the button in BOTH locales.
         A direction-following flex would put the badge on the outer edge on
         /en/ and push the CTA off the right rail it has always sat on. Each
         child then restates its own dir, so the group's direction never
         reaches any text. -->
    <div class="absolute right-0 flex items-center gap-2 sm:gap-3" dir="ltr">
      <!-- Mark only, at every size including desktop - no pill, no visible
           wordmark. Not a link either: the certificate is a credential Marva
           holds, not a referral, and the header already spends its only
           outbound slot on the CTA. The label still sits in the accessibility
           tree via sr-only (and as a hover tooltip via title), so the image
           itself is decorative and takes alt="". -->
      <span dir={dir} title={miluim.badgeLabel} class="inline-flex items-center shrink-0">
        <img
          src="/miluim/miluim-triangle.png"
          alt=""
          width="96"
          height="86"
          loading="eager"
          class="h-9 md:h-11 w-auto shrink-0"
        />
        <span class="sr-only">{miluim.badgeLabel}</span>
      </span>

      <Button href={headerContent.ctaHref} size="m" dir={dir} class="!px-4 !py-2.5 text-sm sm:!px-[22px] sm:!py-3 sm:text-[1rem]">
        {headerContent.ctaLabel}
      </Button>
    </div>
  </div>
</header>

<!-- ═══════════════ FULL-SCREEN NAV OVERLAY (all viewport sizes) ═══════════════ -->
<div
  id="nav-overlay"
  class="fixed inset-0 z-40 bg-ink/95 backdrop-blur-md flex flex-col items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-label={headerContent.menuAriaLabel}
>
  <nav class="flex flex-col items-center gap-7">
    {visible(navLinks).map((l) => (
      <a href={l.href} class="nav-overlay-link font-display font-bold text-2xl text-inverse hover:text-sage transition-colors">
        {l.label}
      </a>
    ))}
  </nav>

  <!-- Language switcher, rehoused. The header globe was removed to free width
       on phones; putting the two locales here keeps switching one tap from the
       top of any page rather than pushing it down to the footer. Plain links,
       so there is no disclosure widget to open and no JS behind it. -->
  <div class="mt-10 flex items-center gap-5">
    {locales.map((l) => (
      l === locale ? (
        <span aria-current="true" class="font-body text-sm text-inverse/50">{localeNames[l]}</span>
      ) : (
        <a href={altLocaleHref(page, locale)} class="nav-overlay-link font-body text-sm text-inverse underline underline-offset-4 hover:text-sage transition-colors">
          {localeNames[l]}
        </a>
      )
    ))}
  </div>
</div>
