---
import { getContent, type Locale } from '../data/content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const { whoStatement, labelPromo } = getContent(locale);
---

<section id="who" class="who-story" aria-labelledby="who-title">
  <div class="who-layout">
    <div class="who-copy">
      <p class="who-eyebrow">{whoStatement.lines[0]}</p>
      <h2 id="who-title">{whoStatement.headline}</h2>
      <div class="who-rule" aria-hidden="true"></div>
      <p class="who-water">{whoStatement.lines[1]}</p>
      <p class="who-caption">{whoStatement.lines[2]}</p>
    </div>

    <div class="who-art">
      <div class="who-scene" aria-hidden="true">
        <div class="who-disc"></div>
        <div class="who-phone">
          <div class="who-phone-camera"></div>
          <div class="who-feed-header"><span></span><i></i><i></i></div>
          <div class="who-ad-slot"></div>
          <div class="who-feed-footer"><i></i><i></i><i></i></div>
          <div class="who-feed-line"></div><div class="who-feed-line who-feed-short"></div>
          <div class="who-phone-home"></div>
        </div>
        <div class="who-ground"></div>
        <div class="who-product">
          <!-- Crop by layout, preserving the original hero image and its detail.
               Multiply blends the photograph's off-white backdrop into sage. -->
          <div class="who-bottle-photo"><img src="/hero-bottle.webp" width="1024" height="1535" alt="" loading="eager" decoding="async" /></div>
          <div class="who-label">
            <div class="who-label-face" dir={locale === 'he' ? 'rtl' : 'ltr'}>
              <img src="/marva-mark.svg" width="26" height="26" alt="" />
              <span>{labelPromo.brandZonePlaceholder}</span>
              <small>{whoStatement.lines[1]}</small>
            </div>
            <div class="who-label-curvature"></div>
            <div class="who-label-shine"></div>
          </div>
        </div>
        <div class="who-orbit"><span></span><span></span><span></span></div>
      </div>
      <div class="who-stages" aria-hidden="true">
        <div class="who-stage-dots"><i></i><i></i><i></i></div>
        <div class="who-stage-captions">
          {whoStatement.stages.map((stage) => <span>{stage}</span>)}
        </div>
      </div>
      <button class="who-replay" type="button" hidden>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 10a8 8 0 1 1 0 5M4 4v6h6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        {whoStatement.replayLabel}
      </button>
    </div>
  </div>
</section>

<style>
  .who-story { background:var(--color-sage-tint); overflow:hidden; padding:clamp(48px,7vw,96px) 24px; }
  .who-layout { max-width:1120px; margin:auto; display:grid; grid-template-columns:1.08fr 1fr; align-items:center; gap:40px; }
  .who-copy { position:relative; z-index:2; min-width:0; }
  .who-eyebrow { font-family:var(--font-body); font-size:clamp(16px,1.5vw,19px); line-height:1.5; margin-bottom:24px; }
  #who-title { font-family:var(--font-display); font-weight:900; font-size:clamp(46px,5.5vw,78px); line-height:1.08; letter-spacing:-.04em; text-wrap:balance; max-width:8em; }
  .who-rule { width:44px; height:3px; background:var(--color-sage-deep); margin:32px 0 24px; }
  .who-water { font-family:var(--font-display); font-weight:700; font-size:clamp(24px,2.6vw,36px); line-height:1.2; text-wrap:balance; }
  .who-caption { font-family:var(--font-body); font-size:clamp(17px,1.8vw,21px); line-height:1.5; margin-top:12px; text-wrap:balance; }
  .who-art { position:relative; min-width:0; }
  .who-scene { position:relative; height:510px; max-width:480px; margin:auto; direction:ltr; isolation:isolate; }
  .who-disc { position:absolute; width:340px; height:340px; border-radius:50%; background:var(--color-sage); opacity:.28; left:calc(50% - 170px); top:96px; }
  .who-product { position:absolute; width:138px; height:480px; top:12px; left:calc(50% - 69px); transform-origin:50% 94%; }
  .who-bottle-photo { position:absolute; inset:0; overflow:hidden; clip-path:polygon(28% 0,72% 0,75% 1%,76% 6%,77% 7%,72% 9%,83% 14%,95% 21%,99% 24%,100% 29%,99% 46%,95% 51%,92% 57%,92% 64%,96% 74%,97% 89%,94% 95%,87% 98%,74% 100%,26% 100%,13% 98%,6% 95%,3% 89%,4% 74%,8% 64%,8% 57%,5% 51%,1% 46%,0 29%,1% 24%,5% 21%,17% 14%,28% 9%,23% 7%,24% 6%,25% 1%); }
  .who-bottle-photo img { position:absolute; width:280.55%; max-width:none; height:auto; left:-90.41%; top:-12.2%; }
  .who-label { position:absolute; top:27.2%; height:20.5%; left:0; width:100%; background:var(--color-sage); border-radius:50% / 6%; overflow:hidden; transform-origin:center; }
  .who-label-face { height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5px; padding:9px 8px; color:var(--color-ink); direction:inherit; }
  .who-label-face img { width:21px; height:21px; }
  .who-label-face span { font-family:var(--font-display); font-size:15px; font-weight:700; line-height:1.1; text-align:center; text-wrap:balance; }
  .who-label-face small { font-family:var(--font-body); font-size:10px; line-height:1.1; }
  .who-label-curvature { position:absolute; inset:0; background:linear-gradient(90deg,#15271b30,transparent 20%,#ffffff33 44%,transparent 75%,#15271b3d); pointer-events:none; }
  .who-label-shine { position:absolute; top:-30%; bottom:-30%; left:-65%; width:40%; background:linear-gradient(90deg,transparent,#ffffffaa,transparent); transform:skewX(-18deg); opacity:0; }
  .who-ground { position:absolute; bottom:10px; left:calc(50% - 82px); width:164px; height:18px; border-radius:50%; background:radial-gradient(ellipse,#263d302f,transparent 70%); }
  .who-phone { position:absolute; width:220px; height:348px; top:86px; left:calc(50% - 110px); border:5px solid var(--color-ink); border-radius:32px; background:var(--color-base); box-shadow:12px 18px 32px #263d301c,inset 0 0 0 2px #fff; opacity:0; padding:40px 16px 20px; }
  .who-phone-camera { position:absolute; top:12px; width:50px; height:11px; left:calc(50% - 25px); background:var(--color-ink); border-radius:12px; }
  .who-feed-header { height:31px; position:relative; }
  .who-feed-header span { position:absolute; width:24px; height:24px; border-radius:50%; background:var(--color-sand); }
  .who-feed-header i { position:absolute; left:33px; top:3px; width:80px; height:5px; border-radius:3px; background:var(--color-border); }
  .who-feed-header i:last-child { top:15px; width:53px; }
  .who-ad-slot { height:122px; background:var(--color-sage-tint); border-radius:8px; margin:18px 0; }
  .who-feed-footer { display:flex; gap:9px; margin:16px 0; }
  .who-feed-footer i { width:11px; height:11px; border:1px solid var(--color-muted); border-radius:50%; }
  .who-feed-footer i:last-child { margin-left:auto; border-radius:2px; }
  .who-feed-line { width:100%; height:5px; background:var(--color-border); margin:8px 0; border-radius:4px; }
  .who-feed-short { width:65%; }
  .who-phone-home { position:absolute; width:70px; height:4px; background:var(--color-ink); bottom:10px; left:calc(50% - 35px); border-radius:5px; }
  .who-orbit { position:absolute; inset:0; pointer-events:none; }
  .who-orbit span { position:absolute; width:13px; height:13px; border-radius:50%; background:var(--color-sky); top:115px; right:45px; }
  .who-orbit span:nth-child(2) { width:24px; height:24px; background:var(--color-sand); left:40px; top:320px; }
  .who-orbit span:nth-child(3) { width:7px; height:7px; top:395px; right:65px; background:var(--color-sage-deep); }
  .who-replay { display:flex; align-items:center; gap:7px; margin:12px auto 0; border:0; padding:10px 14px; min-height:44px; background:transparent; color:var(--color-muted); font-family:var(--font-body); font-size:13px; cursor:pointer; }
  .who-replay[hidden] { display:none; }
  .who-stages { text-align:center; margin-top:18px; }
  .who-stage-dots { display:flex; justify-content:center; gap:8px; margin-bottom:12px; }
  .who-stage-dots i { width:24px; height:3px; border-radius:2px; background:var(--color-sage); }
  .who-stage-captions { display:grid; font-family:var(--font-body); font-size:15px; color:var(--color-ink); }
  .who-stage-captions span { grid-area:1/1; opacity:0; }
  .who-story:not([data-step]) .who-stage-captions span:last-child,
  .who-story[data-step='0'] .who-stage-captions span:nth-child(1),
  .who-story[data-step='1'] .who-stage-captions span:nth-child(2),
  .who-story[data-step='2'] .who-stage-captions span:nth-child(3) { opacity:1; }
  .who-story:not([data-step]) .who-stage-dots i,
  .who-story[data-step='0'] .who-stage-dots i:nth-child(1),
  .who-story[data-step='1'] .who-stage-dots i:nth-child(-n+2),
  .who-story[data-step='2'] .who-stage-dots i { background:var(--color-sage-deep); }
  .who-replay:focus-visible { outline:2px solid var(--color-ink); outline-offset:3px; border-radius:4px; }
  @media (hover:hover) and (pointer:fine) { .who-replay:hover { color:var(--color-ink); } }
  @media(max-width:767px) {
    .who-story { padding:48px 24px 36px; }
    .who-layout { grid-template-columns:1fr; gap:20px; }
    .who-copy { text-align:center; }
    .who-eyebrow { font-size:16px; margin-bottom:16px; }
    #who-title { font-size:clamp(42px,10vw,64px); max-width:9em; margin-inline:auto; }
    .who-rule { margin:22px auto 18px; }
    .who-water { font-size:26px; }
    .who-caption { font-size:17px; margin-top:8px; }
    .who-scene { height:395px; }
    .who-product { width:105px; height:365px; top:12px; left:calc(50% - 52.5px); }
    .who-phone { width:188px; height:307px; top:46px; left:calc(50% - 94px); padding:35px 13px 16px; border-radius:29px; }
    .who-ad-slot { height:104px; margin:12px 0; }
    .who-feed-header { height:25px; }
    .who-feed-footer { margin:13px 0; }
    .who-disc { width:260px; height:260px; left:calc(50% - 130px); top:68px; }
    .who-label-face { gap:3px; padding:5px; }
    .who-label-face img { width:17px; height:17px; }
    .who-label-face span { font-size:12px; }
    .who-label-face small { font-size:8px; }
    .who-ground { width:132px; left:calc(50% - 66px); bottom:10px; }
    .who-orbit span { right:16px; top:78px; }
    .who-orbit span:nth-child(2) { left:13px; top:265px; width:18px; height:18px; }
    .who-orbit span:nth-child(3) { right:27px; top:327px; }
    .who-replay { margin-top:0; }
  }
</style>

<script>
  import { initWhoStory } from '../scripts/who-story';
  initWhoStory();
</script>
