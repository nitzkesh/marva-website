---
import Logo from './Logo.astro';
import { getContent, altLocaleHref, visible, type Locale, type PageKey } from '../data/content';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const { navLinks, footerContent } = getContent(locale);

const toggleHref = altLocaleHref(page, locale);
const toggleLabel = locale === 'he' ? 'EN' : 'עברית';
const toggleAriaLabel = locale === 'he' ? 'Switch to English' : 'עבור לעברית';
---

<!-- ═══════════════════ FOOTER ═══════════════════ -->
<footer class="bg-base border-t border-border py-12 md:py-16">
  <div class="max-w-6xl mx-auto px-6 flex flex-wrap gap-10 justify-between">
    <div>
      <Logo size="sm" locale={locale} />
      <div class="mt-4 font-body text-ink">
        <div class="mb-1.5">{footerContent.ctaLine}</div>
        <div class="flex flex-wrap gap-4 text-muted">
          <span dir="ltr" class="text-end">{footerContent.phoneLabel}: {footerContent.phone}</span>
          <span>·</span>
          <a dir="ltr" href={`mailto:${footerContent.email}`} class="text-end hover:text-sage-deep transition-colors">{footerContent.email}</a>
        </div>
      </div>
    </div>

    <nav aria-label={footerContent.navAriaLabel} class="flex flex-col gap-2 font-body text-ink">
      <span class="form-label mb-1">{footerContent.navHeading}</span>
      {visible(navLinks).map((l) => (
        <a href={l.href} class="hover:text-sage-deep transition-colors">{l.label}</a>
      ))}
      <a href={toggleHref} aria-label={toggleAriaLabel} class="text-muted hover:text-ink transition-colors">{toggleLabel}</a>
    </nav>

    <div class="flex gap-3 items-center h-fit">
      <a href="https://www.instagram.com/marvawater.il/" target="_blank" rel="noopener" aria-label="Instagram — marvawater.il" class="hover:text-sage-deep transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink">
          <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
        </svg>
      </a>
      <span class="w-6 h-6 rounded-full border border-dashed border-border inline-block"></span>
      <span class="w-6 h-6 rounded-full border border-dashed border-border inline-block"></span>
    </div>
  </div>
</footer>
