---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}
const { size = 'md', class: className } = Astro.props;

const sizes = {
  sm: { mark: 'h-7 w-7', text: 'text-2xl' },
  md: { mark: 'h-9 w-9', text: 'text-3xl' },
  lg: { mark: 'h-12 w-12', text: 'text-5xl' },
};
const s = sizes[size] || sizes.md;
---

<div class={['flex items-center gap-2.5', className].filter(Boolean).join(' ')}>
  <img src="/marva-mark.svg" alt="מרווה" class={`${s.mark} object-contain`} />
  <span class={`font-display font-bold text-ink ${s.text}`}>מרווה</span>
</div>
