---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
---

<Layout title="מרווה: הדף לא נמצא" description="הדף המבוקש לא נמצא באתר מרווה." locale="he" page="home">

  <Header locale="he" page="home" />

  <main id="main-content">

    <!-- ═══════════════════ 404 ═══════════════════ -->
    <section class="bg-base py-24 md:py-32">
      <div class="max-w-6xl mx-auto px-6 text-center">
        <h1 class="font-display font-black text-ink text-[clamp(2.25rem,4vw+1rem,3.75rem)] leading-[1.1]">
          הדף לא נמצא
        </h1>
        <p class="font-body text-ink/80 text-lg max-w-[520px] mx-auto mt-4 mb-8">
          הקישור הזה לא מוביל לשום מקום. בואו נחזיר אתכם לדף הבית
        </p>
        <Button href="/" size="l">חזרה לדף הבית</Button>
      </div>
    </section>

  </main>

  <Footer locale="he" page="home" />
</Layout>
