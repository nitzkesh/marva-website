---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Input from '../components/Input.astro';

const whereCards = [
  { title: 'נקודות חלוקה אסטרטגיות', body: 'חופים, טיילות ומוקדים חמים בתל אביב.', accent: 'var(--color-sage)' },
  { title: 'בתי עסק', body: 'הבקבוקים מגיעים ישירות לסניפי הרשת.', accent: 'var(--color-sky)' },
  { title: 'אירועים', body: 'אירועי ספורט ותרבות, כנסים, הרצאות, סמינרים וחתונות.', accent: 'var(--color-sand)' },
  { title: 'סופרמרקטים "הצינור"', body: 'על המדפים בסניפי הרשת.', accent: 'var(--color-sage)' },
];

const howSteps = [
  { n: '01', title: 'קבלת הצעת מחיר', body: 'הצעה לפי פרטי הקמפיין שלכם.' },
  { n: '02', title: 'עיצוב התווית', body: 'מעצבים את התווית — הרקע ואזור עיצוב מוגדר הם שלכם.' },
  { n: '03', title: 'יוצאים לדרך!', body: 'מגיעים ליד של קהל היעד שלכם.' },
];

const routeButtons = [
  { key: 'business', label: 'אני רוצה בקבוקים לעסק שלי' },
  { key: 'find', label: 'איפה תמצאו אותנו?' },
  { key: 'advertise', label: 'אני רוצה לפרסם' },
];

const tabs = [
  { key: 'business', label: 'בקבוקים לעסק שלי' },
  { key: 'find', label: 'איפה תמצאו אותנו?' },
  { key: 'advertise', label: 'אני רוצה לפרסם' },
];

const findSpots = [
  { date: 'א׳, 12.7', loc: 'טיילת תל אביב · מול גורדון' },
  { date: 'ג׳, 14.7', loc: 'חוף פרישמן' },
  { date: 'ה׳, 16.7', loc: 'כיכר הבימה' },
  { date: 'ו׳, 17.7', loc: 'שרונה מרקט' },
  { date: 'ש׳, 18.7', loc: 'דיזנגוף סנטר' },
];
---

<Layout title="מרווה — מים בחינם" description="מפרסמים משלמים על הבקבוקים, אנשים שותים בחינם. מים מינרליים בחינם שהתווית שלהם היא שטח הפרסום שלכם.">

  <!-- ═══════════════════ HEADER ═══════════════════ -->
  <header class="site-header sticky top-0 z-50 bg-base/85 backdrop-blur-sm border-b border-border transition-shadow">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <Logo size="sm" />
      <nav class="hidden md:flex items-center gap-7 font-body text-ink">
        <a href="#who" class="hover:text-sage-deep transition-colors">מי אנחנו</a>
        <a href="#where" class="hover:text-sage-deep transition-colors">לאן מגיעים</a>
        <a href="#how" class="hover:text-sage-deep transition-colors">איך זה עובד</a>
      </nav>
      <Button href="#forms" size="m" data-route="advertise" class="hidden md:inline-flex">אני רוצה לפרסם</Button>
      <button id="hamburger" class="md:hidden relative flex flex-col justify-center items-center gap-[6px] w-10 h-10" aria-label="תפריט ניווט">
        <span class="hamburger-line block w-6 h-[2px] bg-ink rounded-full origin-center transition-transform duration-300"></span>
        <span class="hamburger-line block w-6 h-[2px] bg-ink rounded-full origin-center transition-opacity duration-200"></span>
        <span class="hamburger-line block w-6 h-[2px] bg-ink rounded-full origin-center transition-transform duration-300"></span>
      </button>
    </div>
  </header>

  <!-- ═══════════════ MOBILE NAV OVERLAY ═══════════════ -->
  <div id="mobile-nav" class="fixed inset-0 z-40 bg-ink/95 backdrop-blur-md flex flex-col items-center justify-center opacity-0 pointer-events-none md:hidden transition-opacity duration-300">
    <nav class="flex flex-col items-center gap-7">
      <a href="#who" class="mobile-nav-link font-display font-bold text-2xl text-inverse hover:text-sage transition-colors">מי אנחנו</a>
      <a href="#where" class="mobile-nav-link font-display font-bold text-2xl text-inverse hover:text-sage transition-colors">לאן מגיעים</a>
      <a href="#how" class="mobile-nav-link font-display font-bold text-2xl text-inverse hover:text-sage transition-colors">איך זה עובד</a>
      <Button href="#forms" size="l" data-route="advertise" class="mobile-nav-link mt-6 !bg-base !text-ink !border-base">אני רוצה לפרסם</Button>
    </nav>
  </div>

  <main id="main-content">

    <!-- ═══════════════════ §1 HERO ═══════════════════ -->
    <section class="relative overflow-hidden bg-base py-20 md:py-28">
      <div class="absolute -top-16 [inset-inline-start:-60px] w-64 h-64 bg-sage opacity-50 rounded-[0_0_100%_0] z-0"></div>
      <div class="absolute bottom-10 [inset-inline-end:80px] w-32 h-32 bg-sky opacity-45 rounded-full z-0"></div>
      <div class="absolute -bottom-10 [inset-inline-end:-40px] w-44 h-44 bg-sand opacity-55 z-0"></div>

      <div class="relative z-10 max-w-6xl mx-auto px-6">
        <div class="max-w-[760px]">
          <h1 class="font-display font-black text-ink text-[clamp(2.75rem,5vw+1rem,4.5rem)] leading-[1.05]">
            מים בחינם
          </h1>
          <p class="font-display font-bold text-ink text-[clamp(1.5rem,3vw,2rem)] mt-4">
            המותג שלכם, בידיים של כולם
          </p>
          <p class="font-body text-ink/80 text-lg max-w-[520px] mt-4 mb-8">
            מפרסמים משלמים על הבקבוקים, אנשים שותים בחינם.
          </p>
          <Button href="#forms" size="l" data-route="advertise">אני רוצה לפרסם</Button>
        </div>
      </div>
    </section>

    <!-- ═══════════════ §2 WHO WE ARE ═══════════════ -->
    <section id="who" class="bg-sand-tint py-16 md:py-24">
      <div class="grid grid-cols-1 md:grid-cols-[1.1fr_0.9fr] gap-14 items-center max-w-5xl mx-auto px-6">
        <div>
          <h2 class="who-heading font-display font-bold text-ink text-[clamp(1.75rem,3vw+0.5rem,3rem)]">
            מי אנחנו?
          </h2>
          <p class="font-body text-ink/80 leading-relaxed mt-5 max-w-[460px]">
            חברת מרווה היא פלטפורמה לפרסום על תוויות של בקבוקי מים. כשהבקבוקים מחולקים בחינם — כולם מרוויחים.
          </p>
        </div>

        <div class="relative w-full max-w-[360px] justify-self-center">
          <img src="/lifestyle-bottle-promenade.png" alt="בקבוק מרווה" class="w-full rounded-[20px] block" />
          <div class="absolute top-[43%] [inset-inline-start:31%] w-[42%] h-[46%] bg-base rounded [box-shadow:0_1px_4px_rgba(17,17,17,0.12)] flex flex-col items-center justify-between p-[14px_8px]">
            <span class="flex-1 flex items-center font-display font-bold text-ink text-[clamp(0.7rem,1.6vw,1rem)] text-center">
              המותג שלכם כאן
            </span>
            <div class="flex items-center gap-1">
              <img src="/marva-mark.svg" alt="" class="h-[18px] w-[18px] object-contain" />
              <span class="font-display font-bold text-ink text-xs">מרווה</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════ §3 WHERE BOTTLES GO ═══════════════ -->
    <section id="where" class="bg-surface py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="where-heading font-display font-bold text-ink text-[clamp(1.75rem,3vw+0.5rem,3rem)] text-center">
          לאן הבקבוקים מגיעים?
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 max-w-6xl mx-auto mt-12">
          {whereCards.map((c) => (
            <Card accent={c.accent} class="where-card">
              <h3 class="font-display font-bold text-ink text-xl mb-2.5">{c.title}</h3>
              <p class="font-body text-ink/80">{c.body}</p>
            </Card>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════ §4 HOW IT WORKS ═══════════════ -->
    <section id="how" class="bg-sand-tint py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="how-heading font-display font-bold text-ink text-[clamp(1.75rem,3vw+0.5rem,3rem)] text-center">
          איך זה עובד?
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto mt-12">
          {howSteps.map((s) => (
            <Card class="how-card">
              <div class="font-display font-bold text-sage-deep text-5xl mb-2">{s.n}</div>
              <h3 class="font-display font-bold text-ink text-xl mb-2.5">{s.title}</h3>
              <p class="font-body text-ink/80">{s.body}</p>
            </Card>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════ §5 THREE ROUTES ═══════════════ -->
    <section class="bg-surface py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 max-w-4xl mx-auto">
          {routeButtons.map((o) => (
            <button
              type="button"
              data-route={o.key}
              class="py-7 px-5 rounded-[20px] cursor-pointer bg-sand-tint border border-border font-display font-bold text-lg text-ink transition-all duration-150 hover:bg-sand hover:-translate-y-0.5"
            >
              {o.label}
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════ §6 PARTNERS ═══════════════ -->
    <section id="partners" class="bg-sand-tint py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="partners-heading font-display font-bold text-ink text-[clamp(1.75rem,3vw+0.5rem,3rem)] text-center">
          שותפים
        </h2>
        <div class="dashed-box max-w-5xl mx-auto mt-8">בקרוב</div>
      </div>
    </section>

    <!-- ═══════════════ §7 TESTIMONIALS ═══════════════ -->
    <section id="testimonials" class="bg-surface py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="testimonials-heading font-display font-bold text-ink text-[clamp(1.75rem,3vw+0.5rem,3rem)] text-center">
          ממליצים
        </h2>
        <div class="dashed-box max-w-5xl mx-auto mt-8">בקרוב</div>
      </div>
    </section>

    <!-- ═══════════════ §8 FORMS HUB ═══════════════ -->
    <section id="forms" class="bg-sand-tint py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="forms-heading font-display font-bold text-ink text-[clamp(1.75rem,3vw+0.5rem,3rem)] text-center">
          בואו נתחיל
        </h2>

        <div class="bg-surface rounded-[20px] shadow-card p-6 md:p-10 max-w-[780px] mx-auto mt-8">
          <!-- Tab switcher -->
          <div class="flex gap-2 mb-7 flex-wrap">
            {tabs.map((t) => (
              <button
                type="button"
                data-tab={t.key}
                class={`tab-btn flex-1 py-2.5 px-3.5 rounded-full cursor-pointer font-display font-semibold text-sm border transition-colors ${t.key === 'advertise' ? 'bg-ink text-inverse border-ink' : 'bg-transparent text-ink border-border'}`}
              >
                {t.label}
              </button>
            ))}
          </div>

          <!-- Business panel -->
          <div class="form-panel" data-panel="business" hidden>
            <form class="lead-form">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
                <Input label="שם העסק" name="business_name" placeholder="לדוגמה: קפה השכונה" required />
                <Input label="איש קשר ותפקיד" name="contact" placeholder="שם מלא · תפקיד" required />
                <Input label="טלפון" name="phone" type="tel" dir="ltr" placeholder="050-1234567" required />
                <Input label="מיקום העסק" name="location" placeholder="עיר · כתובת" />
                <Input label="כמות בקבוקים משוערת לחודש" name="qty" placeholder="לדוגמה: 500" class="sm:col-span-2" />
              </div>
              <Button size="l" class="w-full" type="submit">תחזרו אליי</Button>
            </form>
            <div class="form-thanks hidden text-center py-10 font-body text-lg text-sage-deep">תודה! נחזור אליכם בקרוב.</div>
          </div>

          <!-- Find panel -->
          <div class="form-panel" data-panel="find" hidden>
            <p class="font-body text-muted mb-4">נקודות החלוקה הקרובות — מתעדכן לפי תאריכים ומיקומים.</p>
            <ul class="list-none p-0 m-0">
              {findSpots.map((s) => (
                <li class="flex gap-4 items-center py-3.5 border-b border-border">
                  <span class="font-display font-bold text-sm text-sage-deep min-w-[72px]">{s.date}</span>
                  <span class="font-body text-ink">{s.loc}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Advertise panel -->
          <div class="form-panel" data-panel="advertise">
            <form class="ad-form">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                <Input label="שם העסק" name="business_name" placeholder="לדוגמה: קפה השכונה" required />
                <Input label="ח.פ./ע.מ" name="tax_id" placeholder="123456789" />
                <Input label="איש קשר" name="contact" placeholder="שם מלא" required />
                <Input label="טלפון" name="phone" type="tel" dir="ltr" placeholder="050-1234567" required />
                <Input label="אימייל" name="email" type="email" dir="ltr" placeholder="name@company.co.il" required />
                <Input label="כמות בקבוקים רצויה" name="qty" placeholder="לדוגמה: 5,000" />
                <Input label="משך קמפיין" name="duration" placeholder="לדוגמה: חודש" />
                <Input label="תאריך התחלה רצוי" name="start_date" type="date" dir="ltr" />
              </div>

              <div class="mb-5">
                <div class="form-label mb-2">שיטת חלוקה</div>
                <div class="flex flex-col gap-2">
                  <label class="radio-option">
                    <input type="radio" name="delivery" value="supply" checked />
                    <span>אתם מחלקים בעצמכם</span>
                  </label>
                  <label class="radio-option">
                    <input type="radio" name="delivery" value="distribute" />
                    <span>אנחנו מחלקים את הבקבוקים עבורכם</span>
                  </label>
                </div>
                <div id="pref-points" class="conditional-fields">
                  <div class="pt-3.5">
                    <Input label="נקודות חלוקה מועדפות" name="pref_points" placeholder="לדוגמה: טיילת ת״א, חוף גורדון" />
                  </div>
                </div>
              </div>

              <div class="mb-6">
                <button type="button" id="save-toggle" class="py-2.5 px-4.5 rounded-full cursor-pointer bg-transparent border border-ink text-ink font-body font-semibold text-sm transition-colors">
                  אני רוצה לחסוך בעלויות
                </button>
                <div id="save-box" class="conditional-fields">
                  <div class="mt-3.5 bg-sky-tint rounded-[10px] p-4">
                    <p class="font-body text-ink mb-3">אפשר לפרסם על חצי תווית יחד עם מישהו אחר ולשלם פחות.</p>
                    <label class="flex gap-2 items-start cursor-pointer font-body text-ink">
                      <input type="checkbox" class="mt-1" />
                      <span>אני רוצה לפרסם יחד עם מישהו אחר (לא תדעו מי המפרסם שחולק איתכם את התווית).</span>
                    </label>
                  </div>
                </div>
              </div>

              <Button size="l" class="w-full" type="submit">שליחת פנייה</Button>
            </form>
            <div class="form-thanks hidden text-center py-10 font-body text-lg text-sage-deep">תודה! קיבלנו את הפנייה ונחזור אליכם בקרוב.</div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- ═══════════════════ ENDING / FOOTER ═══════════════════ -->
  <footer class="bg-base border-t border-border py-12 md:py-16">
    <div class="max-w-6xl mx-auto px-6 flex flex-wrap gap-6 justify-between items-center">
      <Logo size="sm" />

      <div class="text-center font-body text-ink">
        <div class="mb-1.5">לשאלות נוספות, דברו איתנו:</div>
        <div class="flex gap-4 justify-center text-muted">
          <span>טלפון: 000-0000000</span>
          <span>·</span>
          <span>info@marva.co.il</span>
        </div>
      </div>

      <div class="flex gap-3 items-center">
        <a href="#" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
          </svg>
        </a>
        <span class="w-6 h-6 rounded-full border border-dashed border-border inline-block"></span>
        <span class="w-6 h-6 rounded-full border border-dashed border-border inline-block"></span>
      </div>
    </div>
  </footer>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ── 1. Panel/tab logic ─────────────────────── */
    const tabBtns = document.querySelectorAll<HTMLElement>('.tab-btn');
    const panels = document.querySelectorAll<HTMLElement>('.form-panel');

    function setPanel(key: string) {
      tabBtns.forEach((btn) => {
        const active = btn.dataset.tab === key;
        btn.classList.toggle('bg-ink', active);
        btn.classList.toggle('text-inverse', active);
        btn.classList.toggle('border-ink', active);
        btn.classList.toggle('bg-transparent', !active);
        btn.classList.toggle('text-ink', !active);
        btn.classList.toggle('border-border', !active);
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== key;
      });
    }

    setPanel('advertise');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => setPanel(btn.dataset.tab || 'advertise'));
    });

    /* ── 2. Routing ─────────────────────────────── */
    document.querySelectorAll<HTMLElement>('[data-route]').forEach((el) => {
      el.addEventListener('click', () => {
        const key = el.dataset.route;
        if (!key) return;
        setPanel(key);
        const target = document.getElementById('forms');
        if (target) {
          window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - 20, behavior: 'smooth' });
        }
      });
    });

    /* ── 3. Delivery radios ─────────────────────── */
    const prefPoints = document.getElementById('pref-points');
    document.querySelectorAll<HTMLInputElement>('input[name="delivery"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        prefPoints?.classList.toggle('is-active', radio.checked && radio.value === 'distribute');
      });
    });

    /* ── 4. Save toggle ─────────────────────────── */
    const saveToggle = document.getElementById('save-toggle');
    const saveBox = document.getElementById('save-box');
    let saveOpen = false;
    saveToggle?.addEventListener('click', () => {
      saveOpen = !saveOpen;
      saveBox?.classList.toggle('is-active', saveOpen);
      saveToggle.classList.toggle('bg-sky', saveOpen);
    });

    /* ── 5. Form submit ──────────────────────────── */
    document.querySelectorAll<HTMLFormElement>('.lead-form, .ad-form').forEach((form) => {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }
        form.classList.add('hidden');
        const thanks = form.parentElement?.querySelector('.form-thanks');
        thanks?.classList.remove('hidden');
      });
    });

    /* ── 6. Mobile nav ───────────────────────────── */
    const hamburger = document.getElementById('hamburger');
    const mobileNav = document.getElementById('mobile-nav');
    const mobileNavLinks = mobileNav?.querySelectorAll('a');
    const hamburgerLines = document.querySelectorAll<HTMLElement>('.hamburger-line');
    let navOpen = false;

    function openNav() {
      navOpen = true;
      mobileNav?.classList.remove('opacity-0', 'pointer-events-none');
      if (hamburgerLines[0]) hamburgerLines[0].style.transform = 'translateY(8px) rotate(45deg)';
      if (hamburgerLines[1]) hamburgerLines[1].style.opacity = '0';
      if (hamburgerLines[2]) hamburgerLines[2].style.transform = 'translateY(-8px) rotate(-45deg)';
      document.body.style.overflow = 'hidden';
    }

    function closeNav() {
      navOpen = false;
      mobileNav?.classList.add('opacity-0', 'pointer-events-none');
      if (hamburgerLines[0]) hamburgerLines[0].style.transform = '';
      if (hamburgerLines[1]) hamburgerLines[1].style.opacity = '';
      if (hamburgerLines[2]) hamburgerLines[2].style.transform = '';
      document.body.style.overflow = '';
    }

    hamburger?.addEventListener('click', () => (navOpen ? closeNav() : openNav()));
    mobileNavLinks?.forEach((a) => a.addEventListener('click', closeNav));

    /* ── 7. Header shadow on scroll ─────────────── */
    const header = document.querySelector('.site-header');
    window.addEventListener('scroll', () => {
      header?.classList.toggle('header-scrolled', window.scrollY > 40);
    });

    /* ── 8. Calm scroll reveals with GSAP ───────── */
    if (!reduced) {
      document.querySelectorAll<HTMLElement>('main h2').forEach((h2) => {
        gsap.from(h2, {
          y: 30,
          opacity: 0,
          duration: 0.6,
          ease: 'power2.out',
          scrollTrigger: { trigger: h2, start: 'top 80%' },
        });
      });

      ['.where-card', '.how-card'].forEach((selector) => {
        const cards = document.querySelectorAll<HTMLElement>(selector);
        if (!cards.length) return;
        const section = cards[0].closest('section');
        gsap.from(cards, {
          y: 30,
          opacity: 0,
          duration: 0.6,
          ease: 'power2.out',
          stagger: 0.1,
          scrollTrigger: { trigger: section || cards[0], start: 'top 80%' },
        });
      });
    }
  </script>
</Layout>
