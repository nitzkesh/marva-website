---
import '../styles/global.css';
import { canonicalHref, type Locale, type PageKey } from '../data/content';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  page: PageKey;
}

const { title, description, locale, page } = Astro.props;
const dir = locale === 'he' ? 'rtl' : 'ltr';
const skipLinkLabel = locale === 'he' ? 'דלג לתוכן' : 'Skip to content';

const hePath = canonicalHref(page, 'he');
const enPath = canonicalHref(page, 'en');
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;600&family=Rubik:wght@400;500;700;900&family=Work+Sans:wght@400;500;600&display=optional" />
    <meta name="description" content={description} />
    <link rel="alternate" hreflang="he" href={new URL(hePath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(hePath, Astro.site)} />
    <title>{title}</title>
  </head>
  <body class="bg-base text-ink font-body overflow-x-hidden">
    <a href="#main-content" class="skip-link">{skipLinkLabel}</a>
    <slot />
    <script>
      import '../scripts/shared.ts';
    </script>
  </body>
</html>
